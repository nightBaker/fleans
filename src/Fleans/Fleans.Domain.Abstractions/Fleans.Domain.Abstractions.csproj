<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Engine-internal leaf: marker interfaces, event records carried on Orleans streams, the
         exception hierarchy, and value records those events reference. Depends only on
         Microsoft.Orleans.Sdk. Fleans.Domain adds business logic / aggregates / state machines;
         Fleans.Application.Abstractions adds grain interfaces. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.4.0" />
  </ItemGroup>

</Project>
