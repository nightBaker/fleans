<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <!-- Engine-internal: grain interfaces (script/condition/custom-task), CustomTask schema records,
         narrow IWorkflowInstanceCallback for Worker→Core calls, stream constants, logging context
         helpers, the Fleans meter (FleansDiagnostics). Lets Fleans.Worker stay off Fleans.Application.
         Depends only on Fleans.Domain.Abstractions. Workers don't reference it: they use
         Fleans.ExternalTasks.Sdk, which has no Orleans dependency (#1013). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fleans.Domain.Abstractions\Fleans.Domain.Abstractions.csproj" />
  </ItemGroup>

</Project>
