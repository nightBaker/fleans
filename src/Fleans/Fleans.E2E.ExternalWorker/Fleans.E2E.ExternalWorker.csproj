<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test-only custom-task worker: a generic host whose only Fleans dependency is
       Fleans.ExternalTasks.Sdk, connected to the Fleans API over gRPC. It must NOT reference
       Fleans.Application / Fleans.Domain / Fleans.ServiceDefaults or any Orleans package —
       the point is that a worker needs none of the engine.
       Launched by Fleans.Aspire only when FLEANS_EXTERNAL_WORKER_PROJECT points at this file
       (AspireFixture sets it), and by tests/load/docker-compose.yml. Never packed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>15</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fleans.ExternalTasks.Sdk\Fleans.ExternalTasks.Sdk.csproj" />
  </ItemGroup>

</Project>
