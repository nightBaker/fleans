@* Section navigation, rendered as the Orbit segmented pill bar in the top bar (MainLayout). *@
@using Microsoft.Extensions.Localization
@using Fleans.Web.Services
@implements IDisposable
@inject IStringLocalizer<NavMenu> L
@inject KnowledgeAccess Knowledge

<nav class="orbit-nav" aria-label="@L["Navigation.Label"]">
    <NavLink href="/workflows" Match="NavLinkMatch.Prefix" data-testid="nav-workflows">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="7" height="6" rx="1.5"/><rect x="14" y="14" width="7" height="6" rx="1.5"/><path d="M6.5 10v4a2 2 0 0 0 2 2H14"/></svg>
        @L["Navigation.Workflows"]
    </NavLink>
    <NavLink href="/editor" Match="NavLinkMatch.Prefix" data-testid="nav-editor">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2 22 12 12 22 2 12Z"/></svg>
        @L["Navigation.Editor"]
    </NavLink>
    <NavLink href="/deployments" Match="NavLinkMatch.Prefix" data-testid="nav-deployments">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5"/><path d="M4 17v3h16v-3"/></svg>
        @L["Navigation.Deployments"]
    </NavLink>
    <NavLink href="/admin/custom-tasks" Match="NavLinkMatch.Prefix" data-testid="nav-custom-tasks">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 8 12 3 3 8v8l9 5 9-5Z"/><path d="m3 8 9 5 9-5M12 13v8"/></svg>
        @L["Navigation.CustomTasks"]
    </NavLink>
    <NavLink href="/events" Match="NavLinkMatch.Prefix" data-testid="nav-events">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7Z"/></svg>
        @L["Navigation.Events"]
    </NavLink>
    @if (_showKnowledge)
    {
        <NavLink href="/knowledge" Match="NavLinkMatch.Prefix" data-testid="nav-knowledge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5Z"/><path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5"/></svg>
            @L["Navigation.Knowledge"]
        </NavLink>
    }
</nav>

@code {
    private readonly CancellationTokenSource _cts = new();
    private bool _showKnowledge;

    // After the first render, never during prerender: every page goes through here, and a slow or
    // unreachable assistant backend must not hold up the shell (#1025).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        try
        {
            _showKnowledge = await Knowledge.IsAvailableAsync(_cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        if (_showKnowledge)
            StateHasChanged();
    }

    public void Dispose() => _cts.Cancel();
}
