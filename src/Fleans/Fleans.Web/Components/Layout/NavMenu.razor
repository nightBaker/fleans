@* Section navigation, rendered as the links of the Orbit side rail (MainLayout). *@
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<NavMenu> L

<nav class="orbit-nav" aria-label="@L["Navigation.Label"]">
    <NavLink href="/workflows" Match="NavLinkMatch.Prefix" data-testid="nav-workflows">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
        @L["Navigation.Workflows"]
    </NavLink>
    <span class="orbit-nav__divider" aria-hidden="true"></span>
    <NavLink href="/editor" Match="NavLinkMatch.Prefix" data-testid="nav-editor">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="7" height="6" rx="1.5"/><rect x="14" y="14" width="7" height="6" rx="1.5"/><path d="M10 7h4v7"/></svg>
        @L["Navigation.Editor"]
    </NavLink>
    <NavLink href="/deployments" Match="NavLinkMatch.Prefix" data-testid="nav-deployments">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5"/><path d="M4 17v3h16v-3"/></svg>
        @L["Navigation.Deployments"]
    </NavLink>
    <NavLink href="/admin/custom-tasks" Match="NavLinkMatch.Prefix" data-testid="nav-custom-tasks">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 8 12 3 3 8v8l9 5 9-5Z"/><path d="m3 8 9 5 9-5M12 13v8"/></svg>
        @L["Navigation.CustomTasks"]
    </NavLink>
    <NavLink href="/events" Match="NavLinkMatch.Prefix" data-testid="nav-events">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7Z"/></svg>
        @L["Navigation.Events"]
    </NavLink>
</nav>
