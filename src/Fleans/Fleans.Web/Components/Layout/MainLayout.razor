@inherits LayoutComponentBase
@inject Fleans.Web.Services.ThemeService ThemeService
@implements IDisposable

<FluentDesignTheme @bind-Mode="@_mode"
                   @bind-Mode:after="SyncModeToService"
                   @bind-OfficeColor="@_officeColor"
                   @bind-OfficeColor:after="SyncColorToService"
                   StorageName="theme" />

@* Orbit shell (css/orbit.css): top bar with brand, section nav and theme/settings controls; the page
   fills the rest. .orbit-app re-points Fluent's neutral tokens at the Orbit palette. *@
<div class="orbit-app">
    <header class="orbit-topbar">
        <a class="orbit-brand" href="/workflows" aria-label="Fleans home">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" aria-hidden="true">
                <defs>
                    <marker id="arr" viewBox="0 0 8 6" refX="8" refY="3"
                            markerWidth="5" markerHeight="4" orient="auto">
                        <path d="M 0 0 L 8 3 L 0 6 Z" fill="currentColor"/>
                    </marker>
                </defs>
                <polygon points="256,36 446,146 446,366 256,476 66,366 66,146" fill="none" stroke="currentColor" stroke-width="48"/>
                <rect x="176" y="158" width="44" height="28" rx="5" fill="currentColor"/>
                <rect x="234" y="158" width="44" height="28" rx="5" fill="currentColor"/>
                <rect x="292" y="158" width="44" height="28" rx="5" fill="currentColor"/>
                <rect x="176" y="200" width="44" height="28" rx="5" fill="currentColor"/>
                <rect x="176" y="242" width="44" height="28" rx="5" fill="currentColor"/>
                <rect x="176" y="284" width="44" height="28" rx="5" fill="currentColor"/>
                <rect x="176" y="326" width="44" height="28" rx="5" fill="currentColor"/>
                <rect x="234" y="242" width="44" height="28" rx="5" fill="currentColor"/>
                <line x1="220" y1="172" x2="234" y2="172" stroke="currentColor" stroke-width="2.5" marker-end="url(#arr)"/>
                <line x1="278" y1="172" x2="292" y2="172" stroke="currentColor" stroke-width="2.5" marker-end="url(#arr)"/>
                <line x1="220" y1="256" x2="234" y2="256" stroke="currentColor" stroke-width="2.5" marker-end="url(#arr)"/>
            </svg>
            <span class="orbit-brand__name">FLEANS</span>
            <span class="orbit-chip">BPMN 2.0</span>
        </a>

        <NavMenu />

        <div class="orbit-topbar__end">
            <AuthorizeView>
                <Authorized>
                    <div class="orbit-user">
                        <span class="orbit-avatar" title="Signed in as @context.User.Identity?.Name">@Initials(context.User.Identity?.Name)</span>
                        <span class="nav-user-name">Signed in as @context.User.Identity?.Name</span>
                        <form action="/Account/Logout" method="post">
                            <AntiforgeryToken />
                            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Stealth">Sign out</FluentButton>
                        </form>
                    </div>
                </Authorized>
            </AuthorizeView>

            <button type="button" class="orbit-icon-btn" @onclick="ToggleTheme"
                    aria-label="@ThemeToggleLabel" title="@ThemeToggleLabel" data-testid="theme-toggle">
                @if (_isDark)
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
                }
            </button>

            <a href="/settings" class="orbit-icon-btn" title="Settings" aria-label="Settings">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg>
            </a>
        </div>
    </header>

    <main class="orbit-main">
        @Body
    </main>
</div>

@* E2E hook: only rendered once the SignalR circuit is up (never during prerender),
   so Playwright page objects can wait for interactivity before clicking. *@
@if (RendererInfo.IsInteractive)
{
    <span data-testid="blazor-interactive" hidden></span>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private DesignThemeModes _mode;
    private OfficeColor? _officeColor;
    private bool _isDark;
    private bool _themeUnknown = true;

    private string ThemeToggleLabel => _isDark ? "Switch to light theme" : "Switch to dark theme";

    protected override void OnInitialized()
    {
        _mode = ThemeService.Mode;
        _officeColor = ThemeService.OfficeColor;
        ThemeService.OnChanged += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // "System" resolves to light or dark only in the browser: read what Fluent put on <body>.
        if (!_themeUnknown) return;
        _themeUnknown = false;
        try
        {
            var dark = await JS.InvokeAsync<bool>("fleansOrbit.isDark");
            if (dark == _isDark) return;
            _isDark = dark;
            StateHasChanged();
        }
        catch (JSException)
        {
            // Keep the current icon; the toggle still works.
        }
    }

    private void ToggleTheme()
    {
        _isDark = !_isDark;
        ThemeService.SetTheme(_isDark ? DesignThemeModes.Dark : DesignThemeModes.Light, ThemeService.OfficeColor);
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split([' ', '.', '@', '_', '-'], StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(),
            _ => $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}"
        };
    }

    private void OnThemeChanged()
    {
        _mode = ThemeService.Mode;
        _officeColor = ThemeService.OfficeColor;
        _themeUnknown = _mode == DesignThemeModes.System;
        if (_mode != DesignThemeModes.System) _isDark = _mode == DesignThemeModes.Dark;
        InvokeAsync(StateHasChanged);
    }

    // Raised when FluentDesignTheme changes the theme itself (notably when it restores the
    // persisted value from localStorage), so pages showing the theme (Settings) stay in sync.
    private void SyncModeToService()
    {
        if (ThemeService.Mode != _mode)
            ThemeService.SetTheme(_mode, ThemeService.OfficeColor);
    }

    private void SyncColorToService()
    {
        if (ThemeService.OfficeColor != _officeColor)
            ThemeService.SetTheme(ThemeService.Mode, _officeColor);
    }

    public void Dispose()
    {
        ThemeService.OnChanged -= OnThemeChanged;
    }
}
