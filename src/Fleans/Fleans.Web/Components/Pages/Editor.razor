@page "/editor"
@page "/editor/{ProcessDefinitionKey}"
@page "/editor/{ProcessDefinitionKey}/{Version:int}"
@rendermode InteractiveServer
@using System.Text.Json
@using Fleans.Application
@using Fleans.Application.QueryModels
@using Fleans.Infrastructure.Bpmn
@using Microsoft.FluentUI.AspNetCore.Components
@inject IWorkflowQueryService QueryService
@inject IWorkflowCommandService CommandService
@inject IBpmnConverter BpmnConverter
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<Editor> Logger
@implements IAsyncDisposable

<PageTitle>BPMN Editor</PageTitle>

@* data-editor-ready flips to "true" only after OnAfterRenderAsync has finished its whole
   boot sequence (init → restore tabs → load active/blank tab → persist). Anything that drives
   window.bpmnEditor externally (E2E page objects) MUST wait on it: the modeler object exists
   long before the boot sequence's own loadXml lands, and an import issued in that window is
   silently overwritten by the blank/restored tab (#773).

   Orbit layout (css/orbit.css): toolbar → tabs → [palette + structure + validation | canvas or XML |
   inspector] → status bar. The palette tiles, canvas tools and zoom/cursor read-outs are wired to
   bpmn-js by data attributes in bpmnEditor.bindChrome; right-click menus live in orbitContextMenu.js. *@
<div id="editor-root" class="editor-page" data-editor-ready="@(editorReady ? "true" : "false")">
    <div class="editor-toolbar">
        <FluentButton Appearance="Appearance.Stealth"
                      IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.ArrowLeft())"
                      @onclick="GoBack">
            Back
        </FluentButton>

        <div class="editor-crumbs">
            <span>Process</span>
            <span aria-hidden="true">/</span>
            @if (isEditingProcessId)
            {
                <FluentTextField @bind-Value="processIdEdit"
                                 Autofocus="true"
                                 @onkeydown="OnProcessIdKeyDown"
                                 @onblur="ConfirmProcessIdEdit"
                                 Placeholder="Process ID"
                                 Style="width: 200px;" />
                @if (processIdError != null)
                {
                    <FluentBadge Color="Color.Error">@processIdError</FluentBadge>
                }
            }
            else if (ActiveTab != null && !string.IsNullOrEmpty(ActiveTab.ProcessKey))
            {
                <button type="button" class="process-id-toolbar" @onclick="StartProcessIdEdit" title="Click to edit process ID">
                    @ActiveTab.ProcessKey
                </button>
                <span class="orbit-pill @VersionPillClass" data-testid="editor-version">@VersionPillText</span>
            }
        </div>

        <div class="orbit-segmented" role="group" aria-label="Editor mode">
            <button type="button" aria-pressed="@Pressed(EditorMode.Modeling)" @onclick="() => SwitchMode(EditorMode.Modeling)" data-testid="editor-mode-modeling">Modeling</button>
            <button type="button" aria-pressed="@Pressed(EditorMode.Simulation)" @onclick="() => SwitchMode(EditorMode.Simulation)" data-testid="editor-mode-simulation">Simulation</button>
            <button type="button" aria-pressed="@Pressed(EditorMode.Xml)" @onclick="() => SwitchMode(EditorMode.Xml)" data-testid="editor-mode-xml">XML</button>
            <button type="button" aria-pressed="@Pressed(EditorMode.History)" @onclick="() => SwitchMode(EditorMode.History)" data-testid="editor-mode-history">History</button>
        </div>

        <div class="toolbar-spacer"></div>

        <div class="editor-actions">
            <FluentButton Appearance="Appearance.Stealth"
                          IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Add())"
                          Disabled="@xmlEdited"
                          @onclick="NewDiagramTab">
                New Diagram
            </FluentButton>

            <FluentInputFile @ref="fileUploader"
                             DragDropZoneVisible="false"
                             Mode="InputFileMode.SaveToTemporaryFolder"
                             Multiple="false"
                             AnchorId="ImportBpmnButton"
                             MaximumFileSize="@(10 * 1024 * 1024)"
                             Accept=".bpmn,.xml"
                             OnCompleted="@OnImportFileSelected" />

            <FluentButton Id="ImportBpmnButton"
                          Appearance="Appearance.Neutral"
                          Disabled="@xmlEdited"
                          IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.ArrowUpload())">
                Import BPMN
            </FluentButton>

            <FluentButton Appearance="Appearance.Neutral"
                          Class="editor-action--view"
                          IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.ArrowDownload())"
                          @onclick="DownloadXml">
                Download XML
            </FluentButton>

            <FluentButton Appearance="Appearance.Accent"
                          Class="orbit-deploy"
                          IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Rocket())"
                          Loading="@isDeploying"
                          Disabled="@xmlEdited"
                          Title="@(xmlEdited ? XmlPendingHint : null)"
                          @onclick="ShowDeployDialog">
                Deploy
            </FluentButton>
        </div>
    </div>

    <div class="editor-tab-bar" role="tablist" aria-label="Open diagrams">
        @foreach (var tab in tabs)
        {
            var t = tab;
            var classes = "editor-tab" + (t.Id == activeTabId ? " editor-tab--active" : "");
            <div class="@classes" role="tab" aria-selected="@(t.Id == activeTabId ? "true" : "false")"
                 @onclick="() => SwitchTab(t.Id)" title="@(xmlEdited ? XmlPendingHint : t.Label)">
                <span class="editor-tab__label">@t.Label</span>
                @if (t.Dirty)
                {
                    <span class="editor-tab__dirty" title="Unsaved changes">●</span>
                }
                <button type="button"
                        class="editor-tab__close"
                        title="Close tab"
                        aria-label="Close @t.Label"
                        @onclick="() => RequestCloseTab(t.Id)"
                        @onclick:stopPropagation="true">×</button>
            </div>
        }
    </div>

    <p class="editor-mobile-note">View only on small screens: browse, simulate and compare here, edit on a wider screen.</p>

    <div class="editor-messages">
        @if (errorMessage != null)
        {
            <FluentMessageBar Intent="MessageIntent.Error" Dismissible="true" OnDismissed="@(() => errorMessage = null)">
                @errorMessage
            </FluentMessageBar>
        }

        @if (successMessage != null)
        {
            <FluentMessageBar Intent="MessageIntent.Success" Dismissible="true" OnDismissed="@(() => successMessage = null)">
                @successMessage
            </FluentMessageBar>
        }
    </div>

    <div class="editor-content">
        <aside class="editor-left" aria-label="Elements and structure">
            @if (!ReadOnlyMode)
            {
                <section class="editor-section" aria-label="Elements">
                    <span class="orbit-label">Elements</span>
                    <div class="orbit-palette">
                        @foreach (var tile in PaletteTiles)
                        {
                            <button type="button" class="orbit-tile" draggable="true" data-bpmn-create="@tile.Key"
                                    title="@($"{tile.Title} — click, then click the canvas, or drag it there")">
                                @((MarkupString)tile.Icon)
                                @tile.Label
                            </button>
                        }
                    </div>
                </section>
            }

            <section class="editor-section" aria-label="Structure">
                <span class="orbit-label">Structure</span>
                <div class="orbit-outline" data-testid="editor-outline">
                    @if (summary.Outline.Count == 0)
                    {
                        <span class="orbit-problem__meta">No elements yet</span>
                    }
                    @foreach (var node in summary.Outline)
                    {
                        var n = node;
                        <button type="button" style="padding-left: @(8 + n.Depth * 12)px"
                                aria-current="@(selectedElement?.Id == n.Id ? "true" : "false")"
                                title="@n.Id"
                                @onclick="() => FocusElement(n.Id)">
                            <span class="orbit-dot orbit-dot--@n.Kind"></span>
                            <span class="orbit-outline__name">@(string.IsNullOrWhiteSpace(n.Name) ? TypeCaption(n.Type) : n.Name)</span>
                        </button>
                    }
                </div>
            </section>

            <section class="orbit-validation" aria-label="Validation" data-testid="editor-validation">
                <span class="orbit-label">Validation</span>
                <span class="orbit-validation__row">
                    <span class="orbit-dot orbit-dot--lg orbit-dot--@(summary.ProblemCounts.Errors > 0 ? "error" : "ok")"></span>
                    @Plural(summary.ProblemCounts.Errors, "error")
                </span>
                <span class="orbit-validation__row">
                    <span class="orbit-dot orbit-dot--lg orbit-dot--@(summary.ProblemCounts.Warnings > 0 ? "warning" : "ok")"></span>
                    @Plural(summary.ProblemCounts.Warnings, "warning")
                </span>
                @if (summary.Problems.Count > 0)
                {
                    <button type="button" class="orbit-text-btn" aria-expanded="@(showProblems ? "true" : "false")"
                            @onclick="() => showProblems = !showProblems">
                        @(showProblems ? "Hide problems" : $"Show problems ({summary.Problems.Count})")
                    </button>
                }
                @if (showProblems)
                {
                    <div class="orbit-problems">
                        @foreach (var problem in summary.Problems)
                        {
                            var p = problem;
                            <button type="button" class="orbit-problem orbit-problem--@p.Severity" @onclick="() => FocusElement(p.Id)">
                                <span class="orbit-problem__icon" aria-hidden="true">@(p.Severity == "error" ? "!" : p.Severity == "warning" ? "?" : "i")</span>
                                <span>
                                    @p.Message
                                    <span class="orbit-problem__meta">@(string.IsNullOrWhiteSpace(p.Name) ? p.Id : $"{p.Name} · {p.Id}")</span>
                                </span>
                            </button>
                        }
                    </div>
                }
            </section>
        </aside>

        <div class="editor-center @(xmlMode ? "editor-center--xml" : "") @(ReadOnlyMode ? "editor-center--readonly" : "")">
            @* Focusable so bpmn-js keyboard bindings (bound to this element) receive keys: one tab stop,
               then arrows / shortcuts — design board 7. *@
            <div id="editor-canvas" class="editor-canvas" tabindex="0" role="application"
                 aria-label="BPMN diagram canvas. Shift F10 opens the context menu."></div>

            @if (!editorReady)
            {
                <div class="orbit-overlay" role="status" aria-live="polite">
                    <div class="orbit-overlay__card">
                        <FluentProgressRing Width="28px" />
                        <span class="orbit-overlay__title">Loading diagram</span>
                        <span class="orbit-overlay__meta">Restoring tabs and importing BPMN…</span>
                    </div>
                </div>
            }
            else if (mode == EditorMode.Modeling && summary.Elements == 0)
            {
                <div class="orbit-overlay" data-testid="editor-empty-state">
                    <div class="orbit-overlay__card orbit-overlay__card--wide">
                        <span class="orbit-overlay__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="8"/></svg>
                        </span>
                        <span class="orbit-overlay__title">Empty process</span>
                        <span class="orbit-overlay__meta">Start with a start event, drop elements from the palette, or import a ready-made diagram.</span>
                        <div class="orbit-overlay__actions">
                            <FluentButton Appearance="Appearance.Accent" @onclick="AddStartEvent">Add start event</FluentButton>
                            <FluentButton Appearance="Appearance.Neutral" @onclick="OpenImportPicker">Import .bpmn</FluentButton>
                        </div>
                    </div>
                </div>
            }

            @if (mode == EditorMode.Simulation)
            {
                <div class="orbit-float orbit-float--sim" role="toolbar" aria-label="Simulation controls" data-testid="editor-sim-bar">
                    <span class="orbit-sim-pulse @(simulation?.Running == true ? "is-running" : "")" aria-hidden="true"></span>
                    <span class="orbit-sim-title">Simulation</span>
                    <span class="orbit-sim-meta">
                        step @(simulation?.Step ?? 0) · @(simulation?.ActiveTokens ?? 0) token(s) · @FormatElapsed(simulation?.ElapsedMs ?? 0)
                    </span>
                    <span class="orbit-float__sep" aria-hidden="true"></span>
                    <button type="button" class="orbit-tool" @onclick="ToggleSimulation" disabled="@(simulation?.Finished ?? false)"
                            aria-label="@(simulation?.Running == true ? "Pause" : "Play")" title="@(simulation?.Running == true ? "Pause" : "Play")">
                        @if (simulation?.Running == true)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 5v14M16 5v14"/></svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="7 4 20 12 7 20 7 4"/></svg>
                        }
                    </button>
                    <button type="button" class="orbit-tool" @onclick="@(() => SimCommand("step"))" disabled="@(simulation?.Finished ?? false)" aria-label="Step" title="Step">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="5 4 15 12 5 20 5 4"/><path d="M19 5v14"/></svg>
                    </button>
                    <button type="button" class="orbit-tool" @onclick="RestartSimulation" aria-label="Restart" title="Restart">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 3v6h6"/></svg>
                    </button>
                    <div class="orbit-segmented orbit-segmented--sm" role="group" aria-label="Speed">
                        @foreach (var speed in new[] { 1, 2, 5 })
                        {
                            var sp = speed;
                            <button type="button" aria-pressed="@(((int)(simulation?.Speed ?? 1)) == sp ? "true" : "false")" @onclick="@(() => SimCommand("speed", sp))">@(sp)×</button>
                        }
                    </div>
                    <FluentButton Appearance="Appearance.Neutral" @onclick="() => SwitchMode(EditorMode.Modeling)">Stop</FluentButton>
                </div>
            }

            @if (mode == EditorMode.History && comparison != null)
            {
                <div class="orbit-float orbit-float--legend" aria-label="Comparison legend">
                    <span class="orbit-sim-title">v@(compareVersion) → this tab</span>
                    <span class="orbit-pill orbit-pill--success">+ added @comparison.Added</span>
                    <span class="orbit-pill orbit-pill--draft">~ changed @comparison.Changed</span>
                    <span class="orbit-pill orbit-pill--danger">− removed @comparison.Removed</span>
                </div>
            }

            <div class="orbit-float orbit-float--minimap" aria-label="Minimap">
                <span class="orbit-minimap__head"><span>Minimap</span><span data-orbit-zoom></span></span>
                @* JS-owned SVG (bpmnEditor._bindMinimap) — no Blazor children. *@
                <div class="orbit-minimap" data-orbit-minimap></div>
            </div>

            <div class="orbit-float orbit-float--tools" role="toolbar" aria-label="Canvas tools">
                <button type="button" class="orbit-tool" data-bpmn-tool="select" aria-pressed="true" aria-label="Select" title="Select">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 3l14 8-6 2-2 6Z"/></svg>
                </button>
                <button type="button" class="orbit-tool" data-bpmn-tool="hand" aria-pressed="false" aria-label="Pan (H)" title="Pan (H)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2v20M2 12h20M12 2l-3 3M12 2l3 3M12 22l-3-3M12 22l3-3M2 12l3-3M2 12l3 3M22 12l-3-3M22 12l-3 3"/></svg>
                </button>
                <button type="button" class="orbit-tool" data-bpmn-tool="connect" aria-pressed="false" aria-label="Connect (C)" title="Connect (C)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 20 20 4M14 4h6v6"/></svg>
                </button>
                <button type="button" class="orbit-tool" data-bpmn-tool="lasso" aria-pressed="false" aria-label="Lasso select (L)" title="Lasso select (L)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="3 3" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/></svg>
                </button>
                <button type="button" class="orbit-tool" data-bpmn-tool="space" aria-pressed="false" aria-label="Make space (S)" title="Make space (S)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v18M3 12h6M15 12h6M6 9l-3 3 3 3M18 9l3 3-3 3"/></svg>
                </button>
                <span class="orbit-float__sep" aria-hidden="true"></span>
                <button type="button" class="orbit-tool" data-bpmn-tool="undo" aria-label="Undo (Ctrl Z)" title="Undo (Ctrl Z)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/></svg>
                </button>
                <button type="button" class="orbit-tool" data-bpmn-tool="redo" aria-label="Redo (Ctrl Y)" title="Redo (Ctrl Y)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 14 5-5-5-5"/><path d="M20 9H9a5 5 0 0 0 0 10h3"/></svg>
                </button>
            </div>

            <div class="orbit-float orbit-float--zoom" role="toolbar" aria-label="Zoom">
                <button type="button" class="orbit-tool" data-bpmn-tool="zoom-out" aria-label="Zoom out" title="Zoom out">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"/></svg>
                </button>
                <span class="orbit-zoom-value" data-orbit-zoom aria-live="polite"></span>
                <button type="button" class="orbit-tool" data-bpmn-tool="zoom-in" aria-label="Zoom in" title="Zoom in">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                </button>
                <button type="button" class="orbit-tool" data-bpmn-tool="fit" aria-label="Fit to screen (Shift 1)" title="Fit to screen (Shift 1)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>
                </button>
            </div>

            <div class="orbit-xml" aria-label="XML">
                <div class="orbit-xml__bar">
                    <span class="orbit-label">@XmlFileName</span>
                    @if (xmlError != null)
                    {
                        <span class="orbit-pill orbit-pill--danger" title="@xmlError">Invalid XML</span>
                    }
                    else if (xmlEdited)
                    {
                        <span class="orbit-pill orbit-pill--draft">Edited · not applied</span>
                    }
                    else
                    {
                        <span class="orbit-pill orbit-pill--success">In sync with the diagram</span>
                    }
                    <div class="toolbar-spacer"></div>
                    <FluentButton Appearance="Appearance.Accent" Disabled="@(!xmlEdited)" @onclick="ShowModel">Apply to diagram</FluentButton>
                    <FluentButton Appearance="Appearance.Neutral" Disabled="@(!xmlEdited)" @onclick="DiscardXmlEdits">Discard changes</FluentButton>
                    <FluentButton Appearance="Appearance.Neutral"
                                  IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Copy())"
                                  @onclick="CopyXml">
                        Copy
                    </FluentButton>
                </div>
                @if (xmlError != null)
                {
                    <FluentMessageBar Intent="MessageIntent.Error" Dismissible="true" OnDismissed="@(() => xmlError = null)">
                        The XML could not be applied: @xmlError
                    </FluentMessageBar>
                }
                @* Value is owned by bpmnEditor.enterXmlMode — never bind it from .NET (see bpmnEditor.js). *@
                <textarea id="editor-xml" class="orbit-xml__code" spellcheck="false" aria-label="BPMN XML"></textarea>
            </div>
        </div>

        <aside class="editor-inspector @(selectedElement == null && !ReadOnlyMode ? "editor-inspector--empty" : "")" aria-label="@(ReadOnlyMode ? mode.ToString() : "Properties")">
            @if (mode == EditorMode.Simulation)
            {
                <div class="orbit-empty orbit-run" data-testid="editor-sim-panel">
                    <span class="orbit-label">Simulation · dry run</span>
                    <h2>@SimulationHeadline</h2>
                    <p>Runs in your browser: nothing is deployed and scripts or conditions aren't evaluated — where the process branches or waits, you decide.</p>
                    <div class="orbit-stats">
                        <div class="orbit-stat"><span>Step</span><span>@(simulation?.Step ?? 0)</span></div>
                        <div class="orbit-stat"><span>Visited</span><span>@(simulation?.Visited ?? 0)</span></div>
                    </div>
                    @foreach (var waiting in simulation?.Pending ?? [])
                    {
                        var w = waiting;
                        <div class="orbit-decision">
                            <button type="button" class="orbit-decision__name" @onclick="() => FocusElement(w.ElementId)">
                                <span class="orbit-dot orbit-dot--lg orbit-dot--warning"></span>@w.ElementName
                            </button>
                            <span class="orbit-problem__meta">@TypeCaption(w.ElementType) · waiting</span>
                            <div class="orbit-decision__options">
                                @foreach (var option in w.Options)
                                {
                                    var o = option;
                                    <FluentButton Appearance="@(o.Primary ? Appearance.Accent : Appearance.Neutral)"
                                                  @onclick="() => ChooseSimulationOption(w.TokenId, o.Id)">@o.Label</FluentButton>
                                }
                            </div>
                        </div>
                    }
                    <span class="orbit-label">Log</span>
                    <ol class="orbit-log" reversed>
                        @foreach (var entry in Enumerable.Reverse(simulation?.Log ?? []))
                        {
                            var e = entry;
                            <li>
                                <span class="orbit-log__time">@FormatElapsed(e.AtMs)</span>
                                @if (e.ElementId != null)
                                {
                                    <button type="button" class="orbit-log__text" @onclick="() => FocusElement(e.ElementId)">@e.Text</button>
                                }
                                else
                                {
                                    <span class="orbit-log__text">@e.Text</span>
                                }
                            </li>
                        }
                    </ol>
                </div>
            }
            else if (mode == EditorMode.History)
            {
                <div class="orbit-empty orbit-run" data-testid="editor-history-panel">
                    <span class="orbit-label">History</span>
                    <h2>@(string.IsNullOrEmpty(ActiveTab?.ProcessKey) ? "No process" : ActiveTab.ProcessKey)</h2>
                    @if (historyLoading)
                    {
                        <FluentProgressRing Width="24px" />
                    }
                    else if (historyVersions is { Count: 0 })
                    {
                        <p>No deployed versions yet. Deploy this diagram to start its history.</p>
                    }
                    @if (historyError != null)
                    {
                        <FluentMessageBar Intent="MessageIntent.Error">@historyError</FluentMessageBar>
                    }
                    @if (historyVersions is { Count: > 0 })
                    {
                        <span class="orbit-label">Versions · compare with this tab</span>
                        <div class="orbit-versions">
                            @foreach (var version in historyVersions)
                            {
                                var v = version;
                                <div class="orbit-version @(compareVersion == v.Version ? "is-selected" : "")">
                                    <button type="button" class="orbit-version__main" aria-pressed="@(compareVersion == v.Version ? "true" : "false")"
                                            @onclick="() => CompareWithVersionAsync(v.Version)">
                                        <span class="orbit-pill @(v.IsActive ? "orbit-pill--accent" : "")">v@(v.Version)</span>
                                        <span class="orbit-version__text">
                                            @v.ActivitiesCount activities · @v.SequenceFlowsCount flows@(v.IsActive ? "" : " · disabled")
                                            <span class="orbit-problem__meta">deployed @v.DeployedAt.ToString("yyyy-MM-dd HH:mm") UTC@(ActiveTab?.Version == v.Version ? " · this tab" : "")</span>
                                        </span>
                                    </button>
                                    <button type="button" class="orbit-text-btn" @onclick="() => OpenVersionInTab(v.Version)" title="Open v@(v.Version) in a tab">Open</button>
                                </div>
                            }
                        </div>
                    }
                    @if (comparison != null)
                    {
                        <span class="orbit-label">Changes · v@(compareVersion) → this tab</span>
                        @if (comparison.Items.Count == 0)
                        {
                            <p>No differences: this tab matches v@(compareVersion).</p>
                        }
                        <div class="orbit-problems">
                            @foreach (var change in comparison.Items)
                            {
                                var c = change;
                                <button type="button" class="orbit-problem orbit-change--@c.Kind" disabled="@(c.Kind == "removed")"
                                        @onclick="() => FocusElement(c.Id)">
                                    <span class="orbit-problem__icon" aria-hidden="true">@ChangeSymbol(c.Kind)</span>
                                    <span>
                                        @(string.IsNullOrWhiteSpace(c.Name) ? TypeCaption(c.Type) : c.Name) <span class="orbit-change__kind">@c.Kind</span>
                                        <span class="orbit-problem__meta">@c.Id</span>
                                        @foreach (var f in c.Fields)
                                        {
                                            <span class="orbit-change__field">@f.Field: <s>@(string.IsNullOrEmpty(f.OldValue) ? "—" : f.OldValue)</s> → @(string.IsNullOrEmpty(f.NewValue) ? "—" : f.NewValue)</span>
                                        }
                                    </span>
                                </button>
                            }
                        </div>
                    }
                </div>
            }
            else if (selectedElement != null)
            {
                <ElementPropertiesPanel Element="@selectedElement" OnElementReplaced="OnElementReplaced" />
            }
            else
            {
                <div class="orbit-empty">
                    <span class="orbit-label">Inspector</span>
                    <h2>Nothing selected</h2>
                    <p>Pick an element on the canvas or in Structure to edit its properties. Right-click anything for more actions.</p>
                    <div class="orbit-stats">
                        <div class="orbit-stat"><span>Elements</span><span>@summary.Elements</span></div>
                        <div class="orbit-stat"><span>Flows</span><span>@summary.Flows</span></div>
                        <div class="orbit-stat"><span>Errors</span><span>@summary.ProblemCounts.Errors</span></div>
                        <div class="orbit-stat"><span>Warnings</span><span>@summary.ProblemCounts.Warnings</span></div>
                    </div>
                    <span class="orbit-label">Keyboard</span>
                    <div class="orbit-keys">
                        <div><span>Context menu</span><span class="orbit-kbd">Shift F10</span></div>
                        <div><span>Edit label</span><span class="orbit-kbd">F2</span></div>
                        <div><span>Duplicate</span><span class="orbit-kbd">Ctrl D</span></div>
                        <div><span>Open properties</span><span class="orbit-kbd">Ctrl I</span></div>
                        <div><span>Show XML</span><span class="orbit-kbd">Ctrl E</span></div>
                        <div><span>Fit to screen</span><span class="orbit-kbd">Shift 1</span></div>
                    </div>
                </div>
            }
        </aside>
    </div>

    <footer class="editor-status" aria-label="Status">
        <span class="editor-status__item" data-testid="editor-save-state">
            <span class="orbit-dot orbit-dot--@SaveStateKind"></span>
            @SaveStateText
        </span>
        <span>Fleans · bpmn-js</span>
        <span>@summary.Elements elements · @summary.Flows flows</span>
        <span class="editor-status__end" data-orbit-cursor></span>
        <span>Zoom <span data-orbit-zoom></span></span>
    </footer>
</div>

@if (showDeployDialog)
{
    <div class="deploy-overlay" @onclick="CancelDeploy"></div>
    <div class="deploy-dialog" role="dialog" aria-modal="true" aria-labelledby="deploy-title">
        <span class="orbit-label">Deploy</span>
        <h2 id="deploy-title">Deploy @deployProcessKey @deployNextVersion</h2>
        <ul class="orbit-checklist">
            <li><span class="orbit-check orbit-check--ok" aria-hidden="true">✓</span>BPMN converted for the engine</li>
            <li>
                <span class="orbit-check orbit-check--@(summary.ProblemCounts.Errors > 0 ? "error" : summary.ProblemCounts.Warnings > 0 ? "warn" : "ok")" aria-hidden="true">@(summary.ProblemCounts.Errors + summary.ProblemCounts.Warnings > 0 ? "!" : "✓")</span>
                Modelling hints: @Plural(summary.ProblemCounts.Errors, "error"), @Plural(summary.ProblemCounts.Warnings, "warning")
            </li>
        </ul>
        <p><strong>Process Key:</strong> @deployProcessKey</p>
        <p><strong>Version:</strong> @deployNextVersion</p>
        <p>This will deploy a new version of the workflow definition.</p>
        <div class="deploy-dialog__actions">
            <FluentButton Appearance="Appearance.Neutral" @onclick="CancelDeploy">Cancel</FluentButton>
            <FluentButton Appearance="Appearance.Accent" @onclick="ConfirmDeploy">Deploy</FluentButton>
        </div>
    </div>
}

@if (tabPendingClose != null)
{
    <div class="deploy-overlay" @onclick="CancelCloseTab"></div>
    <div class="deploy-dialog" role="dialog" aria-modal="true" aria-labelledby="discard-title">
        <h2 id="discard-title">Discard unsaved changes?</h2>
        <p>Tab "<strong>@tabPendingClose.Label</strong>" has unsaved changes. Discarding will close the tab and lose those changes.</p>
        <div class="deploy-dialog__actions">
            <FluentButton Appearance="Appearance.Neutral" @onclick="CancelCloseTab">Cancel</FluentButton>
            <FluentButton Appearance="Appearance.Accent" @onclick="ConfirmCloseTab">Discard</FluentButton>
        </div>
    </div>
}

@code {
    private const int MaxTabs = 10;
    private const string StorageKey = "fleans.editor.tabs.v1";

    [Parameter] public string? ProcessDefinitionKey { get; set; }
    [Parameter] public int? Version { get; set; }

    private FluentInputFile? fileUploader;
    private DotNetObjectReference<Editor>? dotNetRef;
    private bool isDeploying;
    private bool showDeployDialog;
    private string? errorMessage;
    private string? successMessage;
    private bool editorInitialized;
    private bool editorReady;

    private string? deployProcessKey;
    private string deployNextVersion = "";
    private string? pendingBpmnXml;
    private Domain.WorkflowDefinition? pendingWorkflow;

    private ElementPropertiesPanel.BpmnElementData? selectedElement;

    private string processIdEdit = "";
    private bool isEditingProcessId;
    private string? processIdError;

    private readonly List<TabSession> tabs = new();
    private string? activeTabId;
    private TabSession? tabPendingClose;

    // XML mode: the text itself stays in the browser (bpmnEditor.enterXmlMode); .NET tracks only
    // whether it was edited, and applies it once the canvas is visible again (OnAfterRenderAsync).
    private const string XmlPendingHint = "Apply or discard the XML changes first";
    private bool xmlEdited;
    private string? xmlError;
    private bool pendingXmlApply;
    private bool pendingCanvasRefresh;
    private string? pendingFocusId;

    private bool showProblems;
    private DiagramSummary summary = new();

    private TabSession? ActiveTab =>
        activeTabId == null ? null : tabs.FirstOrDefault(t => t.Id == activeTabId);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            await CompleteXmlModeExitAsync();
            return;
        }

        dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("bpmnEditor.init", "editor-canvas", dotNetRef);
        await JS.InvokeVoidAsync("bpmnEditor.bindChrome", "editor-root");
        await JS.InvokeVoidAsync("bpmnEditor.registerDirtyCallback", dotNetRef);
        await JS.InvokeVoidAsync("bpmnEditor.registerBeforeUnloadWarning", dotNetRef);
        editorInitialized = true;

        await RestoreTabsFromStorage();

        // Load the restored active tab into the modeler first, so any subsequent
        // SaveActiveTabXml (e.g. inside OpenFromWorkflow when a URL param is present)
        // reads that tab's real content instead of the modeler's default-empty XML
        // and clobbers the restored tab's stored BpmnXml.
        if (tabs.Count > 0)
        {
            await ActivateTab(activeTabId ?? tabs[0].Id, saveOutgoing: false);
        }

        if (!string.IsNullOrEmpty(ProcessDefinitionKey))
        {
            await OpenFromWorkflow(ProcessDefinitionKey, Version);
        }
        else if (tabs.Count == 0)
        {
            await AddBlankTab(activate: true);
        }

        await PersistTabs();
        editorReady = true;
        StateHasChanged();
    }

    [JSInvokable]
    public Task OnModelerDirty()
    {
        var active = ActiveTab;
        if (active != null && !active.Dirty)
        {
            active.Dirty = true;
            _ = UpdateDirtyFlagAndPersist();
            return InvokeAsync(StateHasChanged);
        }
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnDiagramSummary(DiagramSummary diagramSummary)
    {
        summary = diagramSummary;
        if (summary.Problems.Count == 0) showProblems = false;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnShowXmlRequested() => InvokeAsync(() => SwitchMode(EditorMode.Xml));

    [JSInvokable]
    public Task OnXmlEdited(bool edited)
    {
        xmlEdited = edited;
        return InvokeAsync(StateHasChanged);
    }

    // ---- Modes: Modeling | XML -------------------------------------------------------------

    private async Task ShowXml()
    {
        if (xmlMode || !editorInitialized) return;
        await JS.InvokeVoidAsync("bpmnEditor.enterXmlMode", "editor-xml");
        mode = EditorMode.Xml;
        xmlEdited = false;
        xmlError = null;
        StateHasChanged();
    }

    private void ShowModel()
    {
        if (!xmlMode) return;
        mode = EditorMode.Modeling;
        // The canvas is display:none in XML mode; the import (which fits the viewport) and the
        // resize both have to wait until it is laid out again — see CompleteXmlModeExitAsync.
        pendingXmlApply = xmlEdited;
        pendingCanvasRefresh = true;
    }

    private async Task CompleteXmlModeExitAsync()
    {
        if (pendingCanvasRefresh)
        {
            pendingCanvasRefresh = false;
            await JS.InvokeVoidAsync("bpmnEditor.refreshCanvas");
        }

        if (pendingFocusId != null)
        {
            var focusId = pendingFocusId;
            pendingFocusId = null;
            await JS.InvokeAsync<bool>("bpmnEditor.focusElement", focusId);
        }

        if (!pendingXmlApply) return;
        pendingXmlApply = false;

        var result = await JS.InvokeAsync<XmlApplyResult>("bpmnEditor.applyXmlFromEditor", "editor-xml");
        if (!result.Ok)
        {
            // Back to the text so the user can fix it; the diagram keeps its last good state.
            mode = EditorMode.Xml;
            xmlError = result.Error ?? "Unknown error";
            StateHasChanged();
            return;
        }

        xmlEdited = false;
        xmlError = null;
        selectedElement = null;
        if (ActiveTab != null)
        {
            ActiveTab.Dirty = true;
            await RefreshActiveProcessId();
        }
        await UpdateDirtyFlagAndPersist();
        StateHasChanged();
    }

    private async Task DiscardXmlEdits()
    {
        await JS.InvokeVoidAsync("bpmnEditor.enterXmlMode", "editor-xml");
        xmlEdited = false;
        xmlError = null;
    }

    private async Task CopyXml()
    {
        var copied = await JS.InvokeAsync<bool>("bpmnEditor.copyXmlFromEditor", "editor-xml");
        successMessage = copied ? "XML copied to the clipboard." : null;
        errorMessage = copied ? null : "Couldn't copy: the browser blocked clipboard access.";
    }

    // Tab and file actions replace the diagram, so they leave XML mode — unless it holds
    // unapplied edits, which would be lost (their buttons are disabled meanwhile).
    private bool TryLeaveXmlMode()
    {
        if (!xmlMode) return true;
        if (xmlEdited)
        {
            errorMessage = XmlPendingHint + ".";
            return false;
        }
        ShowModel();
        return true;
    }

    private async Task FocusElement(string elementId)
    {
        if (xmlMode)
        {
            // Scrolling needs a laid-out canvas: focus once XML mode has been left.
            if (TryLeaveXmlMode()) pendingFocusId = elementId;
            return;
        }
        await JS.InvokeAsync<bool>("bpmnEditor.focusElement", elementId);
    }

    [JSInvokable]
    public void OnElementSelected(ElementPropertiesPanel.BpmnElementData elementData)
    {
        selectedElement = elementData;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnElementDeselected()
    {
        selectedElement = null;
        InvokeAsync(StateHasChanged);
    }

    private void OnElementReplaced(ElementPropertiesPanel.BpmnElementData newElement)
    {
        selectedElement = newElement;
        StateHasChanged();
    }

    private void StartProcessIdEdit()
    {
        if (ActiveTab == null) return;
        processIdEdit = ActiveTab.ProcessKey;
        processIdError = null;
        isEditingProcessId = true;
    }

    private async Task OnProcessIdKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ConfirmProcessIdEdit();
        }
        else if (e.Key == "Escape")
        {
            isEditingProcessId = false;
            processIdError = null;
        }
    }

    private async Task ConfirmProcessIdEdit()
    {
        if (!isEditingProcessId || ActiveTab == null) return;

        var newId = processIdEdit.Trim();

        if (string.IsNullOrEmpty(newId))
        {
            processIdError = "ID cannot be empty";
            return;
        }

        if (newId.Contains(' '))
        {
            processIdError = "ID cannot contain spaces";
            return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(newId, @"^[a-zA-Z_][\w.\-]*$"))
        {
            processIdError = "ID must start with a letter or underscore";
            return;
        }

        if (newId != ActiveTab.ProcessKey)
        {
            await JS.InvokeAsync<bool>("bpmnEditor.updateProcessId", newId);
            ActiveTab.ProcessKey = newId;
            ActiveTab.Label = newId;
            await PersistTabs();
        }

        isEditingProcessId = false;
        processIdError = null;
    }

    private async Task NewDiagramTab()
    {
        if (!editorInitialized || !await TryReturnToModelingAsync()) return;
        if (!EnsureCapacity()) return;

        // Snapshot the outgoing tab's modeler XML before AddBlankTab replaces
        // the modeler with the fresh empty diagram — otherwise any edits made
        // since the outgoing tab was last activated would be lost.
        await SaveActiveTabXml();

        await AddBlankTab(activate: true);
        await PersistTabs();
        StateHasChanged();
    }

    private async Task OnImportFileSelected(IEnumerable<FluentInputFileEventArgs> files)
    {
        var file = files.FirstOrDefault();
        if (file == null) return;

        try
        {
            if (!string.IsNullOrEmpty(file.ErrorMessage))
            {
                errorMessage = file.ErrorMessage;
                return;
            }

            if (file.LocalFile == null || !file.LocalFile.Exists)
            {
                errorMessage = "File not found. Please try again.";
                return;
            }

            if (!EnsureCapacity() || !await TryReturnToModelingAsync()) return;

            errorMessage = null;
            successMessage = null;

            var bpmnXml = await File.ReadAllTextAsync(file.LocalFile.FullName);
            await SaveActiveTabXml();

            var tab = new TabSession
            {
                Id = Guid.NewGuid().ToString("N"),
                Label = Path.GetFileNameWithoutExtension(file.Name),
                ProcessKey = "",
                Version = null,
                BpmnXml = bpmnXml,
                Dirty = false
            };
            tabs.Add(tab);
            await ActivateTab(tab.Id, saveOutgoing: false);
            successMessage = $"Imported {file.Name}";
            await PersistTabs();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to import BPMN file");
            errorMessage = $"Failed to import file: {ex.Message}";
        }
        finally
        {
            file.LocalFile?.Delete();
        }
    }

    private async Task DownloadXml()
    {
        if (!editorInitialized || ActiveTab == null) return;

        try
        {
            if (xmlMode)
            {
                // The text may hold edits the diagram doesn't have yet: download what the user sees.
                await JS.InvokeVoidAsync("bpmnEditor.downloadXmlFromEditor", "editor-xml", XmlFileName);
                return;
            }

            var xml = await JS.InvokeAsync<string>("bpmnEditor.getXml");
            if (string.IsNullOrEmpty(xml)) return;

            var bytes = System.Text.Encoding.UTF8.GetBytes(xml);
            var base64 = Convert.ToBase64String(bytes);
            var filename = !string.IsNullOrEmpty(ActiveTab.ProcessKey) ? $"{ActiveTab.ProcessKey}.bpmn" : "diagram.bpmn";
            await JS.InvokeVoidAsync("bpmnEditor.downloadXml", base64, filename);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to download XML");
            errorMessage = $"Failed to download: {ex.Message}";
        }
    }

    private async Task ShowDeployDialog()
    {
        if (!editorInitialized || ActiveTab == null || !await TryReturnToModelingAsync()) return;

        try
        {
            errorMessage = null;
            successMessage = null;

            var xml = await JS.InvokeAsync<string>("bpmnEditor.getXml");
            if (string.IsNullOrEmpty(xml))
            {
                errorMessage = "No diagram to deploy.";
                return;
            }

            using var stream = new MemoryStream(System.Text.Encoding.UTF8.GetBytes(xml));
            var workflow = await BpmnConverter.ConvertFromXmlAsync(stream);

            pendingBpmnXml = xml;
            pendingWorkflow = workflow;
            deployProcessKey = workflow.WorkflowId;

            var maxVersion = await QueryService.GetMaxVersionByKeyAsync(deployProcessKey);
            deployNextVersion = $"v{maxVersion + 1}";

            showDeployDialog = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to prepare deployment");
            errorMessage = $"Invalid BPMN: {ex.Message}";
        }
    }

    private void CancelDeploy()
    {
        showDeployDialog = false;
        pendingBpmnXml = null;
        pendingWorkflow = null;
    }

    private async Task ConfirmDeploy()
    {
        if (pendingWorkflow == null || pendingBpmnXml == null || ActiveTab == null) return;

        try
        {
            isDeploying = true;
            showDeployDialog = false;

            var deployed = await CommandService.DeployWorkflow(pendingWorkflow, pendingBpmnXml);
            ActiveTab.ProcessKey = deployed.ProcessDefinitionKey;
            ActiveTab.Version = deployed.Version;
            ActiveTab.Label = deployed.ProcessDefinitionKey;
            ActiveTab.BpmnXml = pendingBpmnXml;
            ActiveTab.Dirty = false;

            successMessage = $"Deployed '{deployed.ProcessDefinitionKey}' v{deployed.Version} ({deployed.ActivitiesCount} activities, {deployed.SequenceFlowsCount} flows)";
            await PersistTabs();
            await UpdateDirtyFlagAndPersist();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to deploy workflow");
            errorMessage = $"Deployment failed: {ex.Message}";
        }
        finally
        {
            isDeploying = false;
            pendingBpmnXml = null;
            pendingWorkflow = null;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/workflows");
    }

    // ---- Tab management --------------------------------------------------

    private bool EnsureCapacity()
    {
        if (tabs.Count >= MaxTabs)
        {
            errorMessage = $"Tab limit reached ({MaxTabs}). Close a tab to open another.";
            return false;
        }
        return true;
    }

    private async Task AddBlankTab(bool activate)
    {
        var id = Guid.NewGuid().ToString("N");
        var label = $"Untitled-{tabs.Count(t => t.Label.StartsWith("Untitled-", StringComparison.Ordinal)) + 1}";

        // Capture bpmn-js's built-in empty diagram XML so tabs all share the same
        // "blank canvas" starting point and round-trip through loadXml correctly.
        await JS.InvokeVoidAsync("bpmnEditor.newDiagram");
        var xml = await JS.InvokeAsync<string>("bpmnEditor.getXml") ?? "";

        var tab = new TabSession
        {
            Id = id,
            Label = label,
            ProcessKey = "",
            Version = null,
            BpmnXml = xml,
            Dirty = false
        };
        tabs.Add(tab);

        if (activate)
        {
            activeTabId = id;
            await RefreshActiveProcessId();
        }
    }

    private async Task OpenFromWorkflow(string processKey, int? version)
    {
        // If already open with the same (key, version), just activate.
        var existing = tabs.FirstOrDefault(t =>
            t.ProcessKey == processKey &&
            t.Version == version);
        if (existing != null)
        {
            await ActivateTab(existing.Id, saveOutgoing: true);
            return;
        }

        if (!EnsureCapacity()) return;

        try
        {
            string bpmnXml = (version.HasValue
                ? await QueryService.GetBpmnXmlByKeyAndVersion(processKey, version.Value)
                : await QueryService.GetBpmnXmlByKey(processKey)) ?? "";

            await SaveActiveTabXml();

            var tab = new TabSession
            {
                Id = Guid.NewGuid().ToString("N"),
                Label = processKey,
                ProcessKey = processKey,
                Version = version,
                BpmnXml = bpmnXml,
                Dirty = false
            };
            tabs.Add(tab);
            await ActivateTab(tab.Id, saveOutgoing: false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load BPMN for key {Key}", processKey);
            errorMessage = $"Failed to load workflow: {ex.Message}";
        }
    }

    private async Task SwitchTab(string tabId)
    {
        if (tabId == activeTabId || !await TryReturnToModelingAsync()) return;
        await ActivateTab(tabId, saveOutgoing: true);
        await PersistTabs();
    }

    private async Task ActivateTab(string tabId, bool saveOutgoing)
    {
        var incoming = tabs.FirstOrDefault(t => t.Id == tabId);
        if (incoming == null) return;

        if (saveOutgoing)
        {
            await SaveActiveTabXml();
        }

        activeTabId = tabId;

        try
        {
            await JS.InvokeVoidAsync("bpmnEditor.loadXml", incoming.BpmnXml);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load BPMN for tab {TabId}", tabId);
            errorMessage = $"Failed to load tab: {ex.Message}";
            return;
        }

        selectedElement = null;
        await RefreshActiveProcessId();
        StateHasChanged();
    }

    private async Task SaveActiveTabXml()
    {
        if (!editorInitialized || ActiveTab == null) return;
        try
        {
            var xml = await JS.InvokeAsync<string>("bpmnEditor.getXml");
            if (!string.IsNullOrEmpty(xml))
            {
                ActiveTab.BpmnXml = xml;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to snapshot XML for active tab");
        }
    }

    private async Task RefreshActiveProcessId()
    {
        if (!editorInitialized || ActiveTab == null) return;
        var id = await JS.InvokeAsync<string>("bpmnEditor.getProcessId");
        if (!string.IsNullOrEmpty(id))
        {
            ActiveTab.ProcessKey = id;
            if (string.IsNullOrEmpty(ActiveTab.Label) || ActiveTab.Label.StartsWith("Untitled-", StringComparison.Ordinal))
            {
                ActiveTab.Label = id;
            }
        }
    }

    private async Task RequestCloseTab(string tabId)
    {
        var tab = tabs.FirstOrDefault(t => t.Id == tabId);
        if (tab == null || (tab.Id == activeTabId && !await TryReturnToModelingAsync())) return;
        if (tab.Dirty)
        {
            tabPendingClose = tab;
            StateHasChanged();
        }
        else
        {
            await PerformCloseTab(tab);
        }
    }

    private void CancelCloseTab()
    {
        tabPendingClose = null;
    }

    private async Task ConfirmCloseTab()
    {
        var tab = tabPendingClose;
        tabPendingClose = null;
        if (tab != null)
        {
            await PerformCloseTab(tab);
        }
    }

    private async Task PerformCloseTab(TabSession tab)
    {
        var idx = tabs.IndexOf(tab);
        var wasActive = tab.Id == activeTabId;
        tabs.RemoveAt(idx);

        if (tabs.Count == 0)
        {
            // Never leave the editor with zero tabs — fall back to a fresh blank.
            await AddBlankTab(activate: true);
        }
        else if (wasActive)
        {
            var nextIdx = Math.Min(idx, tabs.Count - 1);
            await ActivateTab(tabs[nextIdx].Id, saveOutgoing: false);
        }

        // UpdateDirtyFlagAndPersist calls PersistTabs internally — avoid a
        // redundant localStorage serialize on close.
        await UpdateDirtyFlagAndPersist();
        StateHasChanged();
    }

    // ---- Persistence -----------------------------------------------------

    private async Task PersistTabs()
    {
        try
        {
            // Snapshot current modeler XML into the active tab before serializing,
            // so a refresh restores the in-memory edits up to this point.
            await SaveActiveTabXml();

            var payload = new TabsPayload
            {
                ActiveTabId = activeTabId,
                SavedAt = DateTimeOffset.UtcNow,
                Tabs = tabs.Select(t => new TabSessionDto
                {
                    Id = t.Id,
                    Label = t.Label,
                    ProcessKey = t.ProcessKey,
                    Version = t.Version,
                    BpmnXml = t.BpmnXml,
                    Dirty = t.Dirty
                }).ToList()
            };
            var json = JsonSerializer.Serialize(payload);
            var ok = await JS.InvokeAsync<bool>("bpmnEditor.writeStorage", StorageKey, json);
            persistFailed = !ok;
            if (!ok)
            {
                Logger.LogDebug("localStorage write for editor tabs was rejected (quota?)");
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to persist editor tabs");
        }
    }

    private async Task RestoreTabsFromStorage()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("bpmnEditor.readStorage", StorageKey);
            if (string.IsNullOrWhiteSpace(json)) return;

            var payload = JsonSerializer.Deserialize<TabsPayload>(json);
            if (payload?.Tabs == null) return;

            foreach (var dto in payload.Tabs.Take(MaxTabs))
            {
                if (string.IsNullOrEmpty(dto.Id) || string.IsNullOrEmpty(dto.BpmnXml))
                {
                    continue;
                }
                tabs.Add(new TabSession
                {
                    Id = dto.Id,
                    Label = string.IsNullOrEmpty(dto.Label) ? "Untitled" : dto.Label,
                    ProcessKey = dto.ProcessKey ?? "",
                    Version = dto.Version,
                    BpmnXml = dto.BpmnXml,
                    Dirty = dto.Dirty
                });
            }

            if (tabs.Count > 0)
            {
                activeTabId = payload.ActiveTabId != null && tabs.Any(t => t.Id == payload.ActiveTabId)
                    ? payload.ActiveTabId
                    : tabs[0].Id;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to restore editor tabs from localStorage");
        }
    }

    private async Task UpdateDirtyFlagAndPersist()
    {
        var anyDirty = tabs.Any(t => t.Dirty);
        try
        {
            await JS.InvokeVoidAsync("bpmnEditor.setDirtyTabsFlag", anyDirty);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "setDirtyTabsFlag interop failed");
        }
        await PersistTabs();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("bpmnEditor.destroy");
        }
        catch
        {
            // JS interop may fail during disposal
        }

        dotNetRef?.Dispose();
    }

    // ---- View helpers ----------------------------------------------------------

    private string Pressed(EditorMode m) => mode == m ? "true" : "false";

    private string SimulationHeadline => simulation switch
    {
        null => "Starting…",
        { Finished: true } => "Run finished",
        { Pending.Count: > 0 } => "Waiting for you",
        { Running: true } => "Running",
        _ => "Paused"
    };

    // "Draft" = changed since it was opened or deployed; tabs are always kept in localStorage.
    private string SaveStateKind => persistFailed ? "error" : ActiveTab?.Dirty == true ? "warning" : "ok";

    private string SaveStateText => persistFailed
        ? "Couldn't save tabs in this browser (storage full?)"
        : ActiveTab?.Dirty == true
            ? "Draft · kept in this browser, not deployed"
            : ActiveTab?.Version is { } v ? $"In sync with v{v}" : "Saved";

    private Task AddStartEvent() => JS.InvokeVoidAsync("bpmnEditor.addElementAtCenter", "start").AsTask();

    // FluentInputFile opens its picker when its anchor (the toolbar's Import button) is clicked.
    private Task OpenImportPicker() => JS.InvokeVoidAsync("fleansOrbit.click", "ImportBpmnButton").AsTask();

    private string XmlFileName =>
        (string.IsNullOrEmpty(ActiveTab?.ProcessKey) ? "diagram" : ActiveTab.ProcessKey) + ".bpmn";

    // "v3" when the tab matches a deployed version, "v3 · draft" once edited, "draft" before a first deploy.
    private string VersionPillText => ActiveTab switch
    {
        { Version: { } v, Dirty: true } => $"v{v} · draft",
        { Version: { } v } => $"v{v}",
        _ => "draft"
    };

    private string VersionPillClass => ActiveTab is { Version: not null, Dirty: false }
        ? "orbit-pill--accent"
        : "orbit-pill--draft";

    private static string Plural(int count, string noun) => count == 1 ? $"1 {noun}" : $"{count} {noun}s";

    private static string TypeCaption(string bpmnType) =>
        System.Text.RegularExpressions.Regex.Replace(bpmnType.Replace("bpmn:", ""), "([a-z])([A-Z])", "$1 $2");

