@page "/settings"
@rendermode InteractiveServer
@inject Fleans.Web.Services.ThemeService ThemeService
@inject IJSRuntime JS
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Settings> L
@implements IDisposable

<PageTitle>@L["Page.Title"]</PageTitle>

<FluentStack Orientation="Orientation.Vertical" Gap="20px">
    <PageHeader Title="@L["Page.Title"]" Eyebrow="@L["Page.Eyebrow"]" />

    <FluentStack Orientation="Orientation.Vertical" Gap="16px" Class="settings-preferences" Style="max-width: 400px; padding: 0 16px;">
        <CultureSelector />

        <FluentLabel Typo="Typography.Subject">@L["Section.Appearance"]</FluentLabel>

        <FluentSelect TOption="DesignThemeModes"
                      Label="@L["Field.ThemeMode"]"
                      data-testid="settings-theme-mode"
                      Items="@_modeOptions"
                      OptionValue="@(m => m.ToString())"
                      OptionText="@(m => L[$"ThemeMode.{m}"])"
                      @bind-SelectedOption="@SelectedMode" />

        <FluentSelect TOption="OfficeColorOption"
                      Label="@L["Field.AccentColor"]"
                      data-testid="settings-accent-color"
                      Items="@_colorOptions"
                      OptionValue="@(o => o.Label)"
                      OptionText="@(o => L[$"Accent.{o.Label}"])"
                      @bind-SelectedOption="@SelectedColor" />

        <FluentSelect TOption="DiagramThemeOption"
                      Label="@L["Field.DiagramStyle"]"
                      data-testid="settings-diagram-theme"
                      Items="@_diagramThemeOptions"
                      OptionValue="@(o => o.Value)"
                      OptionText="@(o => L[$"DiagramTheme.{o.Label}"])"
                      @bind-SelectedOption="@_selectedDiagramTheme"
                      @bind-SelectedOption:after="SaveDiagramThemeAsync" />
        @if (_diagramThemeNotSaved)
        {
            <span data-testid="settings-diagram-theme-error" style="color: var(--error);">
                @L["Error.DiagramThemeStorage"]
            </span>
        }
    </FluentStack>
</FluentStack>

@code {
    private record OfficeColorOption(string Label, OfficeColor? Value);

    // BPMN editor / instance viewer theme. Values match window.fleansBpmnTheme (js/bpmnTheme.js),
    // which persists the choice in localStorage and applies it when a diagram is opened.
    private record DiagramThemeOption(string Label, string Value);

    private static readonly List<DiagramThemeOption> _diagramThemeOptions =
    [
        new("Orbit", "orbit"),
        new("Classic", "classic"),
        new("Archify", "archify")
    ];

    private DiagramThemeOption _selectedDiagramTheme = _diagramThemeOptions[0];
    private bool _diagramThemeChosen;
    private bool _diagramThemeNotSaved;

    private async Task SaveDiagramThemeAsync()
    {
        _diagramThemeChosen = true;
        _diagramThemeNotSaved = !await JS.InvokeAsync<bool>("fleansBpmnTheme.set", _selectedDiagramTheme.Value);
    }

    private static readonly List<DesignThemeModes> _modeOptions =
    [
        DesignThemeModes.System,
        DesignThemeModes.Light,
        DesignThemeModes.Dark
    ];

    private static readonly List<OfficeColorOption> _colorOptions = BuildColorOptions();

    private DesignThemeModes _selectedMode;
    private OfficeColorOption _selectedColor = null!;

    private DesignThemeModes SelectedMode
    {
        get => _selectedMode;
        set
        {
            if (_selectedMode == value) return;
            _selectedMode = value;
            ThemeService.SetTheme(_selectedMode, _selectedColor.Value);
        }
    }

    private OfficeColorOption SelectedColor
    {
        get => _selectedColor;
        set
        {
            if (_selectedColor == value) return;
            _selectedColor = value;
            ThemeService.SetTheme(_selectedMode, _selectedColor.Value);
        }
    }

    protected override void OnInitialized()
    {
        SyncFromService();
        // MainLayout's FluentDesignTheme restores the persisted theme from localStorage only
        // after the circuit is interactive — i.e. after this page initialised with the
        // ThemeService defaults — so follow later changes instead of snapshotting once.
        ThemeService.OnChanged += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var stored = await JS.InvokeAsync<string>("fleansBpmnTheme.get");
        // The select is interactive while this round-trip is in flight; don't clobber a pick made meanwhile.
        if (_diagramThemeChosen) return;
        _selectedDiagramTheme = _diagramThemeOptions.FirstOrDefault(o => o.Value == stored) ?? _diagramThemeOptions[0];
        StateHasChanged();
    }

    private void SyncFromService()
    {
        _selectedMode = ThemeService.Mode;
        _selectedColor = _colorOptions.First(o => o.Value == ThemeService.OfficeColor);
    }

    private void OnThemeChanged()
    {
        SyncFromService();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.OnChanged -= OnThemeChanged;
    }

    private static List<OfficeColorOption> BuildColorOptions()
    {
        var options = new List<OfficeColorOption> { new("Default", null) };
        foreach (var color in Enum.GetValues<OfficeColor>())
        {
            options.Add(new(color.ToString(), color));
        }
        return options;
    }
}
