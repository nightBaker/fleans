@using Fleans.Assistant.Contracts
@using Fleans.Web.Services
@using Microsoft.Extensions.Localization
@using Microsoft.FluentUI.AspNetCore.Components
@implements IDisposable
@inject HttpAssistantClient Client
@inject IStringLocalizer<Knowledge> L

<div class="knowledge-tab">
    <div class="knowledge-toolbar">
        <FluentTextField @bind-Value="_query" @bind-Value:after="SearchAsync" Placeholder="@L["Search.Placeholder"]"
                         Style="flex: 1; min-width: 240px;" data-testid="knowledge-search-input" />
        <FluentButton Appearance="Appearance.Accent" Loading="@_loading" @onclick="SearchAsync" data-testid="knowledge-search-submit">@L["Action.Search"]</FluentButton>
    </div>
    <div class="knowledge-toolbar">
        @foreach (var kind in Knowledge.Kinds)
        {
            <FluentCheckbox Label="@kind" Value="@_kinds.Contains(kind)" ValueChanged="@((bool on) => ToggleKindAsync(kind, on))"
                            data-testid="@($"knowledge-kind-{kind}")" />
        }
    </div>

    @if (_notFound)
    {
        <div class="orbit-empty" data-testid="knowledge-not-found">@L["Message.NotFound"]</div>
    }
    else if (_error is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Error" data-testid="knowledge-error">@_error</FluentMessageBar>
    }
    else if (_hits is { Count: 0 })
    {
        <div class="orbit-empty" data-testid="knowledge-no-hits">@L["Empty.NoHits"]</div>
    }
    else if (_hits is not null)
    {
        <KnowledgeHitList Hits="@_hits" Sources="@Sources" OnOpen="OnOpen" />
    }
</div>

@code {
    [Parameter] public string? Project { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<KnowledgeSource> Sources { get; set; } = [];
    [Parameter] public EventCallback<KnowledgeFileRef> OnOpen { get; set; }

    private readonly HashSet<string> _kinds = new();
    private CancellationTokenSource? _cts;
    private string? _query;
    private string? _lastSearch;
    private bool _loading;
    private bool _notFound;
    private string? _error;
    private List<KnowledgeHit>? _hits;

    protected override Task OnParametersSetAsync() => SearchAsync();

    private Task ToggleKindAsync(string kind, bool on)
    {
        if (on)
            _kinds.Add(kind);
        else
            _kinds.Remove(kind);
        return SearchAsync();
    }

    private async Task SearchAsync()
    {
        // Typing then clicking Search fires twice, and any parent render lands here: one search per distinct request.
        var query = _query?.Trim();
        var kinds = Knowledge.Kinds.Where(_kinds.Contains).ToList();
        var search = $"{Project}\n{string.Join(',', kinds)}\n{query}";
        if (search == _lastSearch)
            return;
        _lastSearch = search;
        if (string.IsNullOrEmpty(query))
        {
            _cts?.Cancel();
            (_hits, _error, _notFound, _loading) = (null, null, false, false);
            return;
        }

        // The newest search wins; a slower older answer must not overwrite it.
        _cts?.Cancel();
        var cts = _cts = new CancellationTokenSource();
        _loading = true;
        try
        {
            var result = await Client.SearchKnowledgeAsync(query, Project, kinds, cts.Token);
            _notFound = result.IsNotFound;
            _error = result.IsNotFound ? null : result.Error?.Message;
            _hits = result.Page?.Items;
            _loading = false;
            // A failed search can be asked again.
            if (result.Error is not null)
                _lastSearch = null;
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
        }
    }

    public void Dispose() => _cts?.Cancel();
}
