@page "/process-instance/{InstanceId:guid}"
@rendermode InteractiveServer
@using Fleans.Application
@using Fleans.Application.QueryModels
@using Fleans.Domain
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.JSInterop
@using System.Xml.Linq
@inject IWorkflowQueryService QueryService
@inject ICompensationLogService CompensationLogService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<ProcessInstance> Logger
@implements IAsyncDisposable

<PageTitle>@(processName ?? "Instance") · @InstanceId.ToString()[..8]</PageTitle>

<FluentStack Orientation="Orientation.Vertical" Gap="8px">
    @* Compact one-row header: the diagram gets the height. *@
    <PageHeader Title="@(processName ?? "Process Instance")" Eyebrow="Fleans · Process instance" OnGoBack="GoBack"
                Compact="true" Breadcrumbs="@Breadcrumbs">
        <Actions>
            @if (snapshot != null)
            {
                @if (snapshot.IsFailed)
                {
                    <FluentBadge Color="Color.Error">Failed</FluentBadge>
                }
                else if (snapshot.IsCancelled)
                {
                    <FluentBadge Color="Color.Warning">Cancelled</FluentBadge>
                }
                else if (snapshot.IsCompleted)
                {
                    <FluentBadge Color="Color.Success">Completed</FluentBadge>
                }
                else if (snapshot.IsStarted)
                {
                    <FluentBadge Color="Color.Accent">Running</FluentBadge>
                }
                @* #861: which journal version this view reflects, and whether it is the exact live
                   state (from the instance grain) or the read model the projector builds behind it. *@
                <span class="orbit-sim-meta"
                      title="@($"State as of journal version {snapshot.StateVersion}. " + (snapshot.IsFromReadModel
                          ? "Read from the read model, which the projector builds from the instance's journal."
                          : "Read from the instance itself: its exact current state."))"
                      data-testid="instance-state-version">v@(snapshot.StateVersion) · @(snapshot.IsFromReadModel ? "read model" : "live")</span>
            }
            @if (snapshot?.BusinessId is { } businessId)
            {
                <FluentLabel Typo="Typography.Body" Title="Business ID" data-testid="instance-business-id">@businessId</FluentLabel>
            }
            <span class="orbit-sim-meta" title="@InstanceId" data-testid="instance-id">@InstanceId.ToString()[..8]…</span>
            <FluentButton Appearance="Appearance.Stealth"
                          IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Copy())"
                          Title="Copy Instance ID"
                          @onclick="CopyInstanceId" />
            <FluentButton Appearance="Appearance.Stealth"
                          IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.ArrowSync())"
                          Loading="@isRefreshing"
                          Disabled="@(snapshot == null)"
                          Title="Refresh"
                          data-testid="instance-refresh"
                          @onclick="Refresh" />
        </Actions>
    </PageHeader>

    @if (isLoading)
    {
        <FluentStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" Gap="10px">
            <FluentProgressRing />
            <p>Loading instance...</p>
        </FluentStack>
    }
    else if (errorMessage != null)
    {
        <FluentMessageBar Intent="MessageIntent.Error">
            @errorMessage
        </FluentMessageBar>
    }
    else
    {
        <div class="instance-content">
            <div class="instance-main">
                @* Journal replay, like the editor's simulation bar: the diagram shows the run as of an entry. *@
                <div class="orbit-float orbit-float--sim instance-replay" role="toolbar" aria-label="Journal replay" data-testid="instance-replay">
                    <span class="orbit-sim-pulse @(isPlaying ? "is-running" : "")" aria-hidden="true"></span>
                    <span class="orbit-sim-title">Replay</span>
                    <span class="orbit-sim-meta" data-testid="instance-replay-position">
                        @(IsLive ? "live" : $"entry {replayPosition} of {timeline.Count}") · @(replayPosition == 0 ? "0.00 s" : FormatElapsed(timeline[replayPosition - 1].At))
                    </span>
                    <span class="orbit-float__sep" aria-hidden="true"></span>
                    <button type="button" class="orbit-tool" @onclick="() => SeekAsync(0)" disabled="@(replayPosition == 0)"
                            aria-label="Back to the start" title="Back to the start" data-testid="instance-replay-start">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="19 4 9 12 19 20 19 4"/><path d="M5 5v14"/></svg>
                    </button>
                    <button type="button" class="orbit-tool" @onclick="() => SeekAsync(replayPosition - 1)" disabled="@(replayPosition == 0)"
                            aria-label="Step back" title="Step back" data-testid="instance-replay-back">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
                    </button>
                    <button type="button" class="orbit-tool" @onclick="TogglePlay" disabled="@(timeline.Count == 0)"
                            aria-label="@(isPlaying ? "Pause" : "Play")" title="@(isPlaying ? "Pause" : "Play")" data-testid="instance-replay-play">
                        @if (isPlaying)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 5v14M16 5v14"/></svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="7 4 20 12 7 20 7 4"/></svg>
                        }
                    </button>
                    <button type="button" class="orbit-tool" @onclick="() => SeekAsync(replayPosition + 1)" disabled="@IsLive"
                            aria-label="Step forward" title="Step forward" data-testid="instance-replay-forward">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
                    </button>
                    <button type="button" class="orbit-tool" @onclick="() => SeekAsync(timeline.Count)" disabled="@IsLive"
                            aria-label="Jump to the live state" title="Jump to the live state" data-testid="instance-replay-live">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="5 4 15 12 5 20 5 4"/><path d="M19 5v14"/></svg>
                    </button>
                    <input type="range" class="instance-replay__slider" min="0" max="@timeline.Count" value="@replayPosition"
                           @oninput="OnReplaySliderInput" aria-label="Journal position" data-testid="instance-replay-slider" />
                    <div class="orbit-segmented orbit-segmented--sm" role="group" aria-label="Speed">
                        @foreach (var speed in new[] { 1, 2, 5 })
                        {
                            var sp = speed;
                            <button type="button" aria-pressed="@(replaySpeed == sp ? "true" : "false")" @onclick="() => replaySpeed = sp">@(sp)×</button>
                        }
                    </div>
                </div>

                <div id="bpmn-canvas" class="bpmn-container" style="height: @(canvasHeight is { } h ? $"{h}px" : "max(400px, calc(100vh - 260px))");"></div>

                <div id="vertical-drag-handle" class="drag-handle-vertical"></div>

                @if (failedActivities.Count > 0)
                {
                    @foreach (var failed in failedActivities)
                    {
                        <FluentMessageBar Intent="MessageIntent.Error">
                            Activity <strong>@failed.ActivityId</strong> failed: [@failed.ErrorState!.Code] @failed.ErrorState.Message
                        </FluentMessageBar>
                    }
                }

            </div>

            @* The run journal, as in the editor's simulation mode: newest first; clicking an entry replays
               the diagram to it and focuses the element. Entries after the replay position are dimmed. *@
            @if (journalCollapsed)
            {
                <button type="button" class="instance-rail" @onclick="() => TogglePanel(ref journalCollapsed)"
                        aria-label="Show the journal" title="Show the journal" data-testid="instance-journal-expand">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
                    <span>Journal</span>
                </button>
            }
            else
            {
                <aside class="instance-journal" data-testid="instance-journal">
                    <div class="instance-panel__head">
                        <span class="orbit-label">Journal</span>
                        <button type="button" class="orbit-tool instance-panel__collapse" @onclick="() => TogglePanel(ref journalCollapsed)"
                                aria-label="Hide the journal" title="Hide the journal" data-testid="instance-journal-collapse">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
                        </button>
                    </div>
                    @if (timeline.Count == 0)
                    {
                        <span class="orbit-log__text">No activity recorded yet.</span>
                    }
                    <ol class="orbit-log" reversed>
                        @for (var i = timeline.Count - 1; i >= 0; i--)
                        {
                            var e = timeline[i];
                            var position = i + 1;
                            var expanded = expandedEntries.Contains(e.Key);
                            <li data-testid="instance-journal-entry"
                                class="@(position > replayPosition ? "is-future" : position == replayPosition && !IsLive ? "is-current" : null)">
                                <span class="orbit-log__time" title="@e.At.ToString("yyyy-MM-dd HH:mm:ss.fff")">@FormatElapsed(e.At)</span>
                                <button type="button" class="orbit-log__text" @onclick="() => ReplayToEntry(position, e.ActivityId)">
                                    <span class="orbit-dot orbit-dot--@e.Kind"></span> @e.Text
                                </button>
                                <button type="button" class="orbit-tool instance-entry__toggle" @onclick="() => ToggleEntry(e.Key)"
                                        aria-expanded="@(expanded ? "true" : "false")" aria-label="Details" title="Details"
                                        data-testid="instance-journal-entry-toggle">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="@(expanded ? "M6 15l6-6 6 6" : "M6 9l6 6 6-6")"/></svg>
                                </button>
                                @if (expanded && activitiesById.GetValueOrDefault(e.ActivityInstanceId) is { } a)
                                {
                                    <div class="instance-entry" data-testid="instance-journal-details">
                                        <dl>
                                            <dt>Type</dt><dd>@a.ActivityType</dd>
                                            <dt>Status</dt><dd>@GetStatusLabel(a)</dd>
                                            <dt>Instance</dt><dd class="instance-entry__mono" title="@a.ActivityInstanceId">@a.ActivityInstanceId.ToString()[..8]…</dd>
                                            <dt>Created</dt><dd class="instance-entry__mono">@FormatTimestamp(a.CreatedAt)</dd>
                                            <dt>Started</dt><dd class="instance-entry__mono">@FormatTimestamp(a.ExecutionStartedAt)</dd>
                                            <dt>Completed</dt><dd class="instance-entry__mono">@FormatTimestamp(a.CompletedAt)</dd>
                                            @if (a.ErrorState != null)
                                            {
                                                <dt>Error</dt><dd class="instance-entry__error">[@a.ErrorState.Code] @a.ErrorState.Message</dd>
                                            }
                                            @if (!string.IsNullOrEmpty(a.CancellationReason))
                                            {
                                                <dt>Reason</dt><dd>@a.CancellationReason</dd>
                                            }
                                            @if (a.ChildWorkflowInstanceId is { } child)
                                            {
                                                <dt>Child</dt><dd><a href="/process-instance/@child">@child.ToString()[..8]…</a></dd>
                                            }
                                        </dl>

                                        @{ var conditions = snapshot!.ConditionSequences.Where(c => c.SourceActivityId == a.ActivityId).ToList(); }
                                        @if (conditions.Count > 0)
                                        {
                                            <span class="orbit-label">Conditions</span>
                                            <ul class="instance-entry__list">
                                                @foreach (var c in conditions)
                                                {
                                                    <li>
                                                        <span class="orbit-dot orbit-dot--@(c.Result ? "ok" : "error")"></span>
                                                        <span class="instance-entry__mono">@c.SequenceFlowId</span> → @c.TargetActivityId
                                                        <span class="instance-entry__muted">@c.Condition = @(c.Result ? "true" : "false")</span>
                                                    </li>
                                                }
                                            </ul>
                                        }

                                        <dl>
                                            <dt>Variables</dt>
                                            <dd><button type="button" class="instance-entry__link" @onclick="() => ShowScope(a.ActivityId)"
                                                        title="Variable scope @a.VariablesStateId">scope @a.VariablesStateId.ToString()[..8] ›</button></dd>
                                        </dl>

                                        @if (compensationEntries?.FirstOrDefault(c => c.ActivityInstanceId == a.ActivityInstanceId) is { } comp)
                                        {
                                            <span class="orbit-label">Compensation · sequence @comp.CompletedAtSequence · @(comp.IsCompensated ? "compensated" : "pending")@(string.IsNullOrEmpty(comp.HandlerActivityId) ? "" : $" by {comp.HandlerActivityId}")</span>
                                            <span class="instance-entry__muted">Variables when it completed:</span>
                                            <VariableList Variables="@comp.Variables" />
                                        }
                                    </div>
                                }
                            </li>
                        }
                    </ol>
                </aside>
            }

            @* Current variable values per scope; the selected element's scopes come first. Hidden by default. *@
            @if (variablesCollapsed)
            {
                <button type="button" class="instance-rail" @onclick="() => TogglePanel(ref variablesCollapsed)"
                        aria-label="Show the variables" title="Show the variables" data-testid="instance-variables-expand">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
                    <span>Variables</span>
                </button>
            }
            else
            {
                var selectedScopes = SelectedScopeIds();
                <aside class="instance-journal" data-testid="instance-variables">
                    <div class="instance-panel__head">
                        <span class="orbit-label">Variables · current values</span>
                        <button type="button" class="orbit-tool instance-panel__collapse" @onclick="() => TogglePanel(ref variablesCollapsed)"
                                aria-label="Hide the variables" title="Hide the variables" data-testid="instance-variables-collapse">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
                        </button>
                    </div>
                    @if (snapshot!.VariableStates.Count == 0)
                    {
                        <span class="orbit-log__text">No variables recorded.</span>
                    }
                    @foreach (var scope in snapshot.VariableStates.OrderByDescending(v => selectedScopes.Contains(v.VariablesId)))
                    {
                        var usedBy = allActivitiesList.Where(a => a.VariablesStateId == scope.VariablesId).Select(a => a.ActivityId).Distinct().ToList();
                        <section class="instance-scope @(selectedScopes.Contains(scope.VariablesId) ? "is-selected" : null)" data-testid="instance-variable-scope">
                            <span class="instance-entry__mono" title="@scope.VariablesId">scope @scope.VariablesId.ToString()[..8]</span>
                            @if (usedBy.Count > 0)
                            {
                                <span class="instance-entry__muted">@string.Join(", ", usedBy)</span>
                            }
                            <VariableList Variables="@scope.Variables" />
                        </section>
                    }
                </aside>
            }

            @if (selectedElementData != null)
            {
                @if (propertiesCollapsed)
                {
                    <button type="button" class="instance-rail" @onclick="() => TogglePanel(ref propertiesCollapsed)"
                            aria-label="Show the properties" title="Show the properties" data-testid="instance-properties-expand">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
                        <span>Properties</span>
                    </button>
                }
                else
                {
                    <div id="horizontal-drag-handle" class="drag-handle-horizontal"></div>
                    <div id="instance-properties-panel">
                        <div class="instance-panel__head">
                            <span class="orbit-label">Properties</span>
                            <button type="button" class="orbit-tool instance-panel__collapse" @onclick="() => TogglePanel(ref propertiesCollapsed)"
                                    aria-label="Hide the properties" title="Hide the properties" data-testid="instance-properties-collapse">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
                            </button>
                        </div>
                        <ElementPropertiesPanel Element="@selectedElementData" ReadOnly="true" />
                    </div>
                }
            }
        </div>
    }
</FluentStack>

@code {
    [Parameter] public Guid InstanceId { get; set; }

    private InstanceStateSnapshot? snapshot;
    private string? bpmnXml;
    private string? processName; // the BPMN process's name, else its id (the process key)
    private string? processKey;  // the BPMN process's id

    private IReadOnlyList<PageHeader.Crumb> Breadcrumbs => processKey is null
        ? [new("Workflows", "/workflows")]
        : [new("Workflows", "/workflows"), new(processKey, $"/process-instances/{Uri.EscapeDataString(processKey)}")];
    private bool isLoading = true;
    private bool isRefreshing;
    private string? errorMessage;
    private string? selectedActivityId;
    private ElementPropertiesPanel.BpmnElementData? selectedElementData;
    private int? canvasHeight; // null = fill the viewport until the user drags the handle
    private DotNetObjectReference<ProcessInstance>? dotNetRef;
    private bool diagramRendered;

    private List<ActivityInstanceSnapshot> allActivitiesList = [];
    private Dictionary<Guid, ActivityInstanceSnapshot> activitiesById = [];
    private List<ActivityInstanceSnapshot> failedActivities = [];
    private List<ActivityInstanceSnapshot> cancelledActivities = [];

    // Journal — one entry per activity start and per outcome, oldest first (the panel lists it newest
    // first). replayPosition = how many entries the diagram shows; timeline.Count is the live state.
    private record JournalEntry(DateTimeOffset At, Guid ActivityInstanceId, string ActivityId, string Text, string Kind)
    {
        /// <summary>Stable across refreshes, so an expanded entry stays expanded.</summary>
        public string Key => $"{ActivityInstanceId}:{Kind}";
    }
    private List<JournalEntry> timeline = [];
    private int replayPosition;
    private bool IsLive => replayPosition >= timeline.Count;
    private bool isPlaying;
    private int replaySpeed = 1;
    private CancellationTokenSource? playCts;
    private readonly HashSet<string> expandedEntries = [];

    // Side panels can be hidden to give the diagram the room; the canvas re-measures after the render.
    private bool journalCollapsed;
    private bool variablesCollapsed = true;
    private bool propertiesCollapsed = true;
    private bool canvasResizePending;

    // Compensation log — shown in the details of the compensable activity's journal entries.
    private IReadOnlyList<CompensationLogEntrySnapshot>? compensationEntries;

    protected override async Task OnInitializedAsync()
    {
        await LoadInstance();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Don't gate on firstRender: with InteractiveServer, the first await in
        // LoadInstance suspends OnInitializedAsync, so firstRender fires once
        // with bpmnXml/snapshot still null — and subsequent renders have
        // firstRender=false, so the diagram would never initialize. Gate on
        // the fields being populated and a "done it once" flag instead.
        // Also gate on !isLoading: the after-render of the "Loading instance..."
        // pass can run while LoadInstance awaits the compensation log, with
        // bpmnXml/snapshot already set but #bpmn-canvas not in the DOM yet —
        // init would find no container and the flag would block every retry.
        if (!diagramRendered && !isLoading && errorMessage == null && bpmnXml != null && snapshot != null)
        {
            diagramRendered = true;
            await RenderDiagram();
        }
        else if (canvasResizePending && diagramRendered)
        {
            canvasResizePending = false;
            await JS.InvokeVoidAsync("bpmnViewer.resized");
            if (selectedElementData != null && !propertiesCollapsed)
                await InitHorizontalResize();
        }
    }

    private async Task LoadInstance()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            snapshot = await QueryService.GetStateSnapshot(InstanceId);
            bpmnXml = await QueryService.GetBpmnXml(InstanceId);
            (processKey, processName) = ReadProcess(bpmnXml);
            await LoadCompensationLog();

            BuildDerivedState();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading instance {InstanceId}", InstanceId);
            errorMessage = $"Failed to load instance: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadCompensationLog()
    {
        try
        {
            compensationEntries = await CompensationLogService.GetCompensationLog(InstanceId);
        }
        catch (Exception ex)
        {
            // Non-fatal: log it and show no compensation details rather than failing the whole page.
            Logger.LogWarning(ex, "Failed to load compensation log for instance {InstanceId}", InstanceId);
            compensationEntries = Array.Empty<CompensationLogEntrySnapshot>();
        }
    }

    private void BuildDerivedState()
    {
        if (snapshot == null) return;

        allActivitiesList = snapshot.CompletedActivities
            .Concat(snapshot.ActiveActivities)
            .ToList();
        activitiesById = allActivitiesList.ToDictionary(a => a.ActivityInstanceId);
        failedActivities = allActivitiesList.Where(a => a.ErrorState != null).ToList();
        cancelledActivities = allActivitiesList.Where(a => a.IsCancelled).ToList();

        var wasLive = IsLive;
        timeline = BuildJournal(allActivitiesList);
        // A refresh keeps a replay where it is and follows the run when watching it live.
        replayPosition = wasLive ? timeline.Count : Math.Min(replayPosition, timeline.Count);
    }

    private static List<JournalEntry> BuildJournal(IEnumerable<ActivityInstanceSnapshot> activities)
    {
        var entries = new List<JournalEntry>();
        foreach (var a in activities)
        {
            if ((a.ExecutionStartedAt ?? a.CreatedAt) is { } startedAt)
                entries.Add(new JournalEntry(startedAt, a.ActivityInstanceId, a.ActivityId, $"{a.ActivityId} started", "info"));

            if (a.CompletedAt is not { } endedAt) continue;
            if (a.ErrorState != null)
                entries.Add(new JournalEntry(endedAt, a.ActivityInstanceId, a.ActivityId, $"{a.ActivityId} failed: [{a.ErrorState.Code}] {a.ErrorState.Message}", "error"));
            else if (a.IsCancelled)
                entries.Add(new JournalEntry(endedAt, a.ActivityInstanceId, a.ActivityId, $"{a.ActivityId} cancelled", "warning"));
            else if (a.IsCompleted)
                entries.Add(new JournalEntry(endedAt, a.ActivityInstanceId, a.ActivityId, $"{a.ActivityId} completed", "ok"));
        }

        // Stable for equal timestamps: a start stays before its own outcome.
        return entries.OrderBy(e => e.At).ToList();
    }

    /// <summary>Time since the instance started, like the editor's simulation log ("2.71 s").</summary>
    private string FormatElapsed(DateTimeOffset at)
    {
        var origin = snapshot?.ExecutionStartedAt ?? snapshot?.CreatedAt ?? at;
        var elapsed = at - origin;
        if (elapsed < TimeSpan.Zero) elapsed = TimeSpan.Zero;
        return elapsed < TimeSpan.FromMinutes(1)
            ? elapsed.TotalSeconds.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) + " s"
            : elapsed.ToString(elapsed < TimeSpan.FromDays(1) ? @"hh\:mm\:ss" : @"d\.hh\:mm\:ss");
    }

    private async Task ReplayToEntry(int position, string activityId)
    {
        await SeekAsync(position);
        await JS.InvokeVoidAsync("bpmnViewer.selectElement", activityId);
        await OnBpmnElementClicked(activityId);
    }

    private async Task SeekAsync(int position)
    {
        StopPlaying();
        replayPosition = Math.Clamp(position, 0, timeline.Count);
        await HighlightDiagram();
    }

    private async Task OnReplaySliderInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var position))
            await SeekAsync(position);
    }

    private async Task TogglePlay()
    {
        if (isPlaying)
        {
            StopPlaying();
            return;
        }

        // Playing from the live state replays the run from its start.
        if (IsLive) replayPosition = 0;
        await HighlightDiagram();

        isPlaying = true;
        playCts = new CancellationTokenSource();
        _ = PlayAsync(playCts.Token);
    }

    private async Task PlayAsync(CancellationToken ct)
    {
        try
        {
            while (!IsLive)
            {
                await Task.Delay(700 / replaySpeed, ct);
                await InvokeAsync(async () =>
                {
                    if (ct.IsCancellationRequested) return;
                    replayPosition++;
                    await HighlightDiagram();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            // The circuit may be gone mid-replay (navigation away); nothing to recover.
            Logger.LogDebug(ex, "Journal replay stopped for instance {InstanceId}", InstanceId);
        }

        await InvokeAsync(() =>
        {
            if (ct.IsCancellationRequested) return;
            isPlaying = false;
            StateHasChanged();
        });
    }

    private void StopPlaying()
    {
        playCts?.Cancel();
        playCts?.Dispose();
        playCts = null;
        isPlaying = false;
    }

    private void TogglePanel(ref bool collapsed)
    {
        collapsed = !collapsed;
        canvasResizePending = true;
    }

    /// <summary>Variable scopes of the selected element's activity instances (a loop or fork can have several).</summary>
    private HashSet<Guid> SelectedScopeIds() => selectedActivityId == null
        ? []
        : allActivitiesList.Where(a => a.ActivityId == selectedActivityId).Select(a => a.VariablesStateId).ToHashSet();

    private async Task ShowScope(string activityId)
    {
        if (variablesCollapsed) TogglePanel(ref variablesCollapsed);
        await JS.InvokeVoidAsync("bpmnViewer.selectElement", activityId);
        await OnBpmnElementClicked(activityId);
    }

    /// <summary>
    /// The executable process's id (the process key) and name (else its id) — the first process when
    /// none is marked executable.
    /// </summary>
    private static (string? Key, string? Name) ReadProcess(string? xml)
    {
        if (string.IsNullOrEmpty(xml)) return (null, null);
        try
        {
            XNamespace bpmn = "http://www.omg.org/spec/BPMN/20100524/MODEL";
            var processes = XDocument.Parse(xml).Descendants(bpmn + "process").ToList();
            var process = processes.FirstOrDefault(p => (string?)p.Attribute("isExecutable") == "true") ?? processes.FirstOrDefault();
            var key = (string?)process?.Attribute("id");
            var name = (string?)process?.Attribute("name");
            return (key, string.IsNullOrWhiteSpace(name) ? key : name);
        }
        catch (System.Xml.XmlException)
        {
            return (null, null);
        }
    }

    private void ToggleEntry(string key)
    {
        if (!expandedEntries.Remove(key))
            expandedEntries.Add(key);
    }

    private static string FormatTimestamp(DateTimeOffset? at) =>
        at?.ToString("yyyy-MM-dd HH:mm:ss.fff", System.Globalization.CultureInfo.InvariantCulture) ?? "—";

    private async Task HighlightDiagram()
    {
        if (snapshot == null) return;
        if (!IsLive)
        {
            await HighlightReplay();
            return;
        }

        var errorActivityIds = failedActivities.Select(a => a.ActivityId).ToArray();
        var cancelledActivityIds = cancelledActivities.Select(a => a.ActivityId).ToArray();
        var lastActivity = allActivitiesList
            .OrderByDescending(a => a.CompletedAt ?? a.ExecutionStartedAt ?? a.CreatedAt)
            .FirstOrDefault();
        var lastErrorId = lastActivity?.ErrorState != null ? lastActivity.ActivityId : null;
        // Done = completed cleanly and not running again (a loop re-enters the same element).
        var completedActivityIds = allActivitiesList
            .Where(a => a.IsCompleted && a.ErrorState == null && !a.IsCancelled)
            .Select(a => a.ActivityId)
            .Except(snapshot.ActiveActivityIds)
            .Except(errorActivityIds)
            .Distinct()
            .ToArray();
        await JS.InvokeVoidAsync("bpmnViewer.highlight", snapshot.ActiveActivityIds, errorActivityIds, lastErrorId, cancelledActivityIds, completedActivityIds);

        var orderedActivityIds = snapshot.CompletedActivities
            .Concat(snapshot.ActiveActivities)
            .OrderBy(a => a.CreatedAt)
            .Select(a => a.ActivityId)
            .ToArray();
        await JS.InvokeVoidAsync("bpmnViewer.highlightExecutionPath", (object)orderedActivityIds);
    }

    /// <summary>Paints the run as of the first <see cref="replayPosition"/> journal entries.</summary>
    private async Task HighlightReplay()
    {
        var shown = timeline.Take(replayPosition).ToList();
        var startedIds = shown.Where(e => e.Kind == "info").Select(e => e.ActivityInstanceId).ToHashSet();
        var outcomes = shown.Where(e => e.Kind != "info").ToDictionary(e => e.ActivityInstanceId, e => e.Kind);
        var started = allActivitiesList.Where(a => startedIds.Contains(a.ActivityInstanceId)).ToList();

        string[] IdsWith(Func<ActivityInstanceSnapshot, bool> predicate) =>
            started.Where(predicate).Select(a => a.ActivityId).Distinct().ToArray();

        var activeIds = IdsWith(a => !outcomes.ContainsKey(a.ActivityInstanceId));
        var errorIds = IdsWith(a => outcomes.GetValueOrDefault(a.ActivityInstanceId) == "error");
        var cancelledIds = IdsWith(a => outcomes.GetValueOrDefault(a.ActivityInstanceId) == "warning");
        var completedIds = IdsWith(a => outcomes.GetValueOrDefault(a.ActivityInstanceId) == "ok")
            .Except(activeIds)
            .Except(errorIds)
            .ToArray();
        var lastErrorId = shown.LastOrDefault() is { Kind: "error" } last ? last.ActivityId : null;
        await JS.InvokeVoidAsync("bpmnViewer.highlight", activeIds, errorIds, lastErrorId, cancelledIds, completedIds);

        var orderedActivityIds = started
            .OrderBy(a => a.CreatedAt)
            .Select(a => a.ActivityId)
            .ToArray();
        await JS.InvokeVoidAsync("bpmnViewer.highlightExecutionPath", (object)orderedActivityIds);
    }

    private async Task RenderDiagram()
    {
        if (bpmnXml == null || snapshot == null) return;

        await JS.InvokeVoidAsync("bpmnViewer.init", "bpmn-canvas", bpmnXml);
        await HighlightDiagram();

        dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("bpmnViewer.registerClickHandler", dotNetRef);

        var viewportHeight = await JS.InvokeAsync<int>("dragResize.getViewportHeight");
        var maxHeight = Math.Max(viewportHeight - 200, 400);
        await JS.InvokeVoidAsync("dragResize.initVertical", "vertical-drag-handle", "bpmn-canvas", 200, maxHeight, dotNetRef, "OnCanvasResized");
    }

    private async Task Refresh()
    {
        isRefreshing = true;
        try
        {
            errorMessage = null;
            snapshot = await QueryService.GetStateSnapshot(InstanceId);
            await LoadCompensationLog();
            BuildDerivedState();
            StateHasChanged();
            await Task.Yield();
            if (snapshot != null)
            {
                await HighlightDiagram();
                if (selectedActivityId != null)
                {
                    await JS.InvokeVoidAsync("bpmnViewer.selectElement", selectedActivityId);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing instance {InstanceId}", InstanceId);
            errorMessage = $"Failed to refresh instance: {ex.Message}";
        }
        finally
        {
            isRefreshing = false;
        }
    }

    private async Task GoBack()
    {
        await JS.InvokeVoidAsync("history.back");
    }

    private async Task CopyInstanceId()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", InstanceId.ToString());
    }

    [JSInvokable]
    public async Task OnBpmnElementClicked(string elementId)
    {
        selectedActivityId = string.IsNullOrEmpty(elementId) ? null : elementId;

        if (!string.IsNullOrEmpty(elementId))
        {
            var props = await JS.InvokeAsync<ElementPropertiesPanel.BpmnElementData?>("bpmnViewer.getElementProperties", elementId);
            selectedElementData = props;
        }
        else
        {
            selectedElementData = null;
        }

        await InvokeAsync(StateHasChanged);

        if (selectedElementData != null && !propertiesCollapsed)
        {
            await Task.Yield();
            await InitHorizontalResize();
        }
    }

    [JSInvokable]
    public async Task OnCanvasResized(double newHeight)
    {
        canvasHeight = (int)newHeight;
        StateHasChanged();
        if (bpmnXml != null)
        {
            await JS.InvokeVoidAsync("bpmnViewer.refit");
        }
    }

    private async Task InitHorizontalResize()
    {
        if (dotNetRef == null) return;
        await JS.InvokeVoidAsync("dragResize.initHorizontal", "horizontal-drag-handle", "instance-properties-panel", 200, 600, dotNetRef, "OnPanelResized");
    }

    [JSInvokable]
    public void OnPanelResized(double newWidth)
    {
        // Intentionally empty: panel width is managed by JS on the DOM element directly
    }


    private static string GetStatusLabel(ActivityInstanceSnapshot a)
    {
        if (a.ErrorState != null) return "Failed";
        if (a.IsCancelled) return "Cancelled";
        if (a.IsCompleted) return "Completed";
        if (a.IsExecuting) return "Running";
        return "Pending";
    }

    public async ValueTask DisposeAsync()
    {
        StopPlaying();
        try
        {
            await JS.InvokeVoidAsync("bpmnViewer.destroy");
        }
        catch
        {
            // JS interop may fail during disposal
        }
        dotNetRef?.Dispose();
    }
