    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", InstanceId.ToString());
    }

    private static IQueryable<VariableRow> GetVariableRows(VariableStateSnapshot vs)
        => vs.Variables.Select(kvp => new VariableRow(kvp.Key, kvp.Value)).AsQueryable();

    private async Task OnActivityRowClick(FluentDataGridRow<ActivityInstanceSnapshot> row)
    {
        if (row.Item is null) return;
        selectedActivityId = row.Item.ActivityId;
        await JS.InvokeVoidAsync("bpmnViewer.selectElement", row.Item.ActivityId);

        var props = await JS.InvokeAsync<ElementPropertiesPanel.BpmnElementData?>("bpmnViewer.getElementProperties", row.Item.ActivityId);
        selectedElementData = props;
        StateHasChanged();

        if (selectedElementData != null)
        {
            await Task.Yield();
            await InitHorizontalResize();
        }
    }

    [JSInvokable]
    public async Task OnBpmnElementClicked(string elementId)
    {
        selectedActivityId = string.IsNullOrEmpty(elementId) ? null : elementId;

        if (!string.IsNullOrEmpty(elementId))
        {
            var props = await JS.InvokeAsync<ElementPropertiesPanel.BpmnElementData?>("bpmnViewer.getElementProperties", elementId);
            selectedElementData = props;
        }
        else
        {
            selectedElementData = null;
        }

        await InvokeAsync(StateHasChanged);

        if (selectedElementData != null)
        {
            await Task.Yield();
            await InitHorizontalResize();
        }
    }

    [JSInvokable]
    public async Task OnCanvasResized(double newHeight)
    {
        canvasHeight = (int)newHeight;
        StateHasChanged();
        if (bpmnXml != null)
        {
            await JS.InvokeVoidAsync("bpmnViewer.refit");
        }
    }

    private async Task InitHorizontalResize()
    {
        if (dotNetRef == null) return;
        await JS.InvokeVoidAsync("dragResize.initHorizontal", "horizontal-drag-handle", "instance-properties-panel", 200, 600, dotNetRef, "OnPanelResized");
    }

    [JSInvokable]
    public void OnPanelResized(double newWidth)
    {
        // Intentionally empty: panel width is managed by JS on the DOM element directly
    }

    private string? GetActivityRowClass(ActivityInstanceSnapshot item)
        => selectedActivityId != null && item.ActivityId == selectedActivityId ? "activity-row-selected" : null;

    private void OnCompensationRowClick(FluentDataGridRow<CompensationLogEntrySnapshot> row)
    {
        if (row.Item is null) return;
        selectedCompensationEntry = row.Item;
        selectedCompensationVariableRows = row.Item.Variables
            .Select(kvp => new VariableRow(kvp.Key, kvp.Value))
            .AsQueryable();
    }

    private string? GetCompensationRowClass(CompensationLogEntrySnapshot item)
        => selectedCompensationEntry != null
           && item.ActivityInstanceId == selectedCompensationEntry.ActivityInstanceId
            ? "activity-row-selected"
            : null;

    private static string GetStatusLabel(ActivityInstanceSnapshot a)
    {
        if (a.ErrorState != null) return "Failed";
        if (a.IsCancelled) return "Cancelled";
        if (a.IsCompleted) return "Completed";
        if (a.IsExecuting) return "Running";
        return "Pending";
    }

    public async ValueTask DisposeAsync()
    {
        StopPlaying();
        try
        {
            await JS.InvokeVoidAsync("bpmnViewer.destroy");
        }
        catch
        {
            // JS interop may fail during disposal
        }
        dotNetRef?.Dispose();
    }
