@page "/workflows"
@rendermode InteractiveServer
@using Fleans.Application
@using Fleans.Application.QueryModels
@using Fleans.Domain
@using Microsoft.FluentUI.AspNetCore.Components
@using System.Globalization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Workflows> L
@inject IWorkflowQueryService QueryService
@inject IWorkflowCommandService CommandService
@inject NavigationManager Navigation
@inject Fleans.Web.Services.EnvironmentClient Environments

@implements IDisposable

<PageTitle>@L["Page.Title"]</PageTitle>

<FluentStack Orientation="Orientation.Vertical" Gap="20px" >
    <PageHeader Title="@L["Page.Heading"]" Eyebrow="@L["Page.Eyebrow"]">
        <Actions>
            <FluentButton Appearance="Appearance.Accent"
                          IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Add())"
                          @onclick="NewWorkflow">
                @L["Action.New"]
            </FluentButton>
            <FluentButton Appearance="Appearance.Neutral"
                          IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.ArrowSync())"
                          @onclick="RefreshWorkflows"
                          Disabled="@isLoading">
                @L["Action.Refresh"]
            </FluentButton>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(loadErrorMessage))
    {
        <FluentMessageBar Intent="MessageIntent.Error" Dismissible="true" OnDismissed="@(() => loadErrorMessage = null)">
            <FluentStack Orientation="Orientation.Horizontal" Gap="10px" AlignItems="AlignItems.Center">
                <span>@loadErrorMessage</span>
                <FluentButton Appearance="Appearance.Neutral" @onclick="RefreshWorkflows" Disabled="@isLoading">
                    @L["Action.Retry"]
                </FluentButton>
            </FluentStack>
        </FluentMessageBar>
    }

    @if (!string.IsNullOrWhiteSpace(actionErrorMessage))
    {
        <FluentMessageBar Intent="MessageIntent.Error" Dismissible="true" OnDismissed="@(() => actionErrorMessage = null)">
            <span data-testid="workflows-action-error">@actionErrorMessage</span>
        </FluentMessageBar>
    }

    @if (!string.IsNullOrWhiteSpace(actionSuccessMessage))
    {
        <FluentMessageBar Intent="MessageIntent.Success" Dismissible="true" OnDismissed="@(() => actionSuccessMessage = null)">
            <span data-testid="workflows-action-success">@actionSuccessMessage</span>
        </FluentMessageBar>
    }

    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12">
        <FluentTextField Placeholder="@L["Search.Placeholder"]" AriaLabel="@L["Search.Placeholder"]"
                         @bind-Value="SearchQuery"
                         Style="max-width: 320px;"
                         data-testid="workflows-search" />
        <FluentTextField Placeholder="@L["BusinessId.Placeholder"]" AriaLabel="@L["BusinessId.Placeholder"]"
                         @bind-Value="startBusinessId"
                         Maxlength="@BusinessIdRules.MaxLength"
                         Style="max-width: 320px;"
                         data-testid="workflows-start-business-id" />
    </FluentStack>

    <div class="workflows-grid-container">
        <FluentDataGrid ItemsProvider="@workflowsProvider"
                        Pagination="@pagination"
                        TGridItem="ProcessDefinitionRow"
                        GridTemplateColumns="minmax(12rem, 1fr) max-content max-content max-content"
                        Class="workflows-grid"
                        Loading="@isLoading"
                        ColumnSortLabels="@sortLabels"
                        data-testid="workflows-grid"
                        OnToggle="@((ProcessDefinitionRow row) => OnRowToggledAsync(row))"
                        @ref="grid">
            <EmptyContent><span data-testid="workflows-empty">@L["Grid.Empty"]</span></EmptyContent>
            <LoadingContent><span role="status">@L["Grid.Loading"]</span></LoadingContent>
            <ChildContent>
                <TemplateColumn Title="@L["Column.ProcessKey"]" HierarchicalToggle="true">
                    <strong title="@context.Item.ProcessDefinitionId"
                            class="@(context.Item.IsActive ? "" : "process-disabled")">
                        @context.Item.ProcessDefinitionKey
                        @if (!context.Item.IsActive)
                        {
                            <FluentBadge Color="Color.Warning" Style="margin-left: 8px;">@L["State.Disabled"]</FluentBadge>
                        }
                    </strong>
                </TemplateColumn>
                <TemplateColumn Title="@L["Column.Version"]">
                    <FluentBadge Color="Color.Accent">v@(context.Item.Version)</FluentBadge>
                </TemplateColumn>
                <TemplateColumn Title="@L["Column.DeployedAt"]" Sortable="true" @ref="deployedAtColumn">
                    <time datetime="@context.Item.DeployedAt.ToUniversalTime().ToString("O", CultureInfo.InvariantCulture)" data-testid="workflow-deployed-at">@context.Item.DeployedAt.ToUniversalTime().ToString("g", CultureInfo.CurrentCulture)</time>
                </TemplateColumn>
                <TemplateColumn Title="@L["Column.Actions"]">
                    <FluentStack Orientation="Orientation.Horizontal" Class="workflows-actions" HorizontalGap="4" VerticalGap="4">
                        <FluentButton Appearance="Appearance.Stealth"
                                      IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Edit())"
                                      @onclick="() => EditWorkflow(context.Item)">
                            @L["Action.Edit"]
                        </FluentButton>
                        <FluentButton Appearance="Appearance.Stealth"
                                      IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Play())"
                                      Loading="@(isStarting && startingProcessDefinitionId == context.Item.ProcessDefinitionId)"
                                      Disabled="@(isStarting || !context.Item.IsActive)"
                                      @onclick="() => StartVersion(context.Item)">
                            @L["Action.Start"]
                        </FluentButton>
                        <FluentButton Appearance="Appearance.Stealth"
                                      IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.List())"
                                      @onclick="() => ViewInstances(context.Item)">
                            @L["Action.Instances"]
                        </FluentButton>
                        @if (Environments.Targets.Count > 0)
                        {
                            <FluentButton Appearance="Appearance.Stealth"
                                          IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.ArrowUpload())"
                                          @onclick="() => ShowPromote(context.Item)"
                                          data-testid="workflows-promote">
                                @L["Action.Promote"]
                            </FluentButton>
                        }
                        @if (context.Item.IsActive)
                        {
                            <FluentButton Appearance="Appearance.Stealth"
                                          IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Pause())"
                                          Loading="@(isToggling && togglingProcessKey == context.Item.ProcessDefinitionKey)"
                                          Disabled="@isToggling"
                                          @onclick="() => ToggleActive(context.Item)">
                                @L["Action.Disable"]
                            </FluentButton>
                        }
                        else
                        {
                            <FluentButton Appearance="Appearance.Stealth"
                                          IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.CheckmarkCircle())"
                                          Loading="@(isToggling && togglingProcessKey == context.Item.ProcessDefinitionKey)"
                                          Disabled="@isToggling"
                                          @onclick="() => ToggleActive(context.Item)">
                                @L["Action.Enable"]
                            </FluentButton>
                        }
                    </FluentStack>
                </TemplateColumn>
            </ChildContent>
        </FluentDataGrid>
    </div>
    @if (pagination.TotalItemCount is { } count)
    {
        <div class="workflows-pagination" data-testid="workflows-pagination">
            <span>@L["Pagination.Total", count]</span>
            @if (count > 0)
            {
                <nav aria-label="@L["Pagination.Label"]" class="workflows-pagination__nav">
                    <FluentButton Disabled="@(pagination.CurrentPageIndex == 0)" @onclick="() => pagination.SetCurrentPageIndexAsync(0)" data-testid="workflows-first-page">@L["Pagination.First"]</FluentButton>
                    <FluentButton Disabled="@(pagination.CurrentPageIndex == 0)" @onclick="() => pagination.SetCurrentPageIndexAsync(pagination.CurrentPageIndex - 1)" data-testid="workflows-previous-page">@L["Pagination.Previous"]</FluentButton>
                    <span data-testid="workflows-page-number">@L["Pagination.Page", pagination.CurrentPageIndex + 1, (pagination.LastPageIndex ?? 0) + 1]</span>
                    <FluentButton Disabled="@(pagination.CurrentPageIndex >= pagination.LastPageIndex)" @onclick="() => pagination.SetCurrentPageIndexAsync(pagination.CurrentPageIndex + 1)" data-testid="workflows-next-page">@L["Pagination.Next"]</FluentButton>
                    <FluentButton Disabled="@(pagination.CurrentPageIndex >= pagination.LastPageIndex)" @onclick="() => pagination.SetCurrentPageIndexAsync(pagination.LastPageIndex ?? 0)" data-testid="workflows-last-page">@L["Pagination.Last"]</FluentButton>
                </nav>
            }
        </div>
    }
</FluentStack>

@if (promoteVersion is { } version)
{
    <PromoteDialog Version="version" OnClose="@(() => promoteVersion = null)" />
}

@code {
    private sealed class ProcessDefinitionRow : HierarchicalGridItem<ProcessDefinitionSummary, ProcessDefinitionRow>
    {
    }

    private ColumnSortLabels sortLabels => new()
    {
        SortMenu = L["Sort.Menu"],
        SortMenuAscendingLabel = L["Sort.Ascending"],
        SortMenuDescendingLabel = L["Sort.Descending"]
    };

    private FluentDataGrid<ProcessDefinitionRow>? grid;
    private TemplateColumn<ProcessDefinitionRow>? deployedAtColumn;
    private PaginationState pagination = new() { ItemsPerPage = 20 };
    private GridItemsProvider<ProcessDefinitionRow>? workflowsProvider;
    private bool isLoading;
    private string? loadErrorMessage;
    private string? actionErrorMessage;
    private string? actionSuccessMessage;
    private bool isStarting = false;
    private string? startingProcessDefinitionId;
    private string? startBusinessId;
    private bool isToggling = false;
    private string? togglingProcessKey;
    private string searchQuery = string.Empty;
    private Timer? searchDebounceTimer;

    // The grid renders exactly what the ItemsProvider returns, so collapsed children
    // (IsHidden) must be filtered out by the provider itself. Expanded groups are tracked by
    // key so the expand/collapse state survives the re-query triggered by a toggle.
    private readonly HashSet<string> expandedKeys = new(StringComparer.Ordinal);

    private string SearchQuery
    {
        get => searchQuery;
        set
        {
            if (searchQuery == value)
                return;

            searchQuery = value;
            DebounceSearch();
        }
    }

    protected override void OnInitialized()
    {
        pagination.TotalItemCountChanged += OnTotalItemCountChanged;
        workflowsProvider = async request =>
        {
            try
            {
                isLoading = true;
                loadErrorMessage = null;

                var sortString = BuildSortString(request);
                var filters = string.IsNullOrWhiteSpace(searchQuery)
                    ? null
                    : $"ProcessDefinitionKey@={searchQuery}";

                var page = new PageRequest(
                    Page: (request.StartIndex / pagination.ItemsPerPage) + 1,
                    PageSize: pagination.ItemsPerPage,
                    Sorts: sortString,
                    Filters: filters
                );

                var result = await QueryService.GetProcessDefinitionGroups(page);

                var rows = result.Items
                    .SelectMany(group =>
                    {
                        var versions = group.Versions;
                        var expanded = expandedKeys.Contains(versions[0].ProcessDefinitionKey);
                        var parent = new ProcessDefinitionRow
                        {
                            Item = versions[0],
                        };

                        var children = versions.Skip(1)
                            .Select(d => new ProcessDefinitionRow
                            {
                                Item = d,
                                Depth = 1,
                                IsHidden = !expanded,
                            })
                            .ToList();

                        foreach (var child in children)
                        {
                            parent.Children.Add(child);
                        }

                        parent.IsCollapsed = !expanded;

                        return new[] { parent }.Concat(children.Where(c => !c.IsHidden));
                    })
                    .ToList();

                isLoading = false;
                return GridItemsProviderResult.From(rows, result.TotalCount);
            }
            catch (Exception ex)
            {
                LogLoadWorkflowsError(ex);
                loadErrorMessage = L["Error.Load"];
                isLoading = false;
                return GridItemsProviderResult.From(
                    new List<ProcessDefinitionRow>(), 0);
            }
        };
    }

    private async Task OnRowToggledAsync(ProcessDefinitionRow row)
    {
        // The grid flips IsCollapsed before raising OnToggle.
        if (row.IsCollapsed)
            expandedKeys.Remove(row.Item.ProcessDefinitionKey);
        else
            expandedKeys.Add(row.Item.ProcessDefinitionKey);

        if (grid is not null)
        {
            await grid.RefreshDataAsync();
        }
    }

    private string? BuildSortString(
        GridItemsProviderRequest<ProcessDefinitionRow> request)
    {
        if (request.SortByColumn is null)
            return "ProcessDefinitionKey";

        // Column identity, not a translated title, determines the server-side sort property.
        if (!ReferenceEquals(request.SortByColumn, deployedAtColumn))
            return "ProcessDefinitionKey";

        var dir = request.SortByAscending == false ? "-" : "";
        return $"{dir}DeployedAt";
    }

    private void OnTotalItemCountChanged(object? sender, int? count) => _ = InvokeAsync(StateHasChanged);

    private void DebounceSearch()
    {
        searchDebounceTimer?.Dispose();
        searchDebounceTimer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                if (grid is not null)
                {
                    await pagination.SetCurrentPageIndexAsync(0);
                    await grid.RefreshDataAsync();
                }
                StateHasChanged();
            });
        }, null, 300, Timeout.Infinite);
    }

    private async Task RefreshWorkflows()
    {
        if (grid is not null)
        {
            await grid.RefreshDataAsync();
        }
    }

    private void NewWorkflow()
    {
        Navigation.NavigateTo("/editor");
    }

    private void EditWorkflow(ProcessDefinitionSummary definition)
    {
        Navigation.NavigateTo($"/editor/{Uri.EscapeDataString(definition.ProcessDefinitionKey)}/{definition.Version}");
    }

    private async Task StartVersion(ProcessDefinitionSummary version)
    {
        try
        {
            isStarting = true;
            startingProcessDefinitionId = version.ProcessDefinitionId;
            actionErrorMessage = null;
            actionSuccessMessage = null;

            // Sent as typed: padding is rejected (400 over REST) rather than trimmed, here too.
            var businessId = string.IsNullOrEmpty(startBusinessId) ? null : startBusinessId;
            var instanceId = await CommandService.StartWorkflowByProcessDefinitionId(version.ProcessDefinitionId, businessId);
            LogProcessStarted(version.ProcessDefinitionId, instanceId);
            actionSuccessMessage = L["Message.Started", version.ProcessDefinitionKey, version.Version, instanceId]
                + (businessId is null ? "" : L["Message.BusinessId", businessId]);
            // A business id tags one instance; don't carry it over to the next Start click.
            startBusinessId = null;
        }
        catch (KeyNotFoundException ex)
        {
            LogProcessStartFailed(version.ProcessDefinitionId, ex.Message);
            actionErrorMessage = L["Error.Start", ex.Message];
        }
        catch (Exception ex)
        {
            LogProcessStartError(version.ProcessDefinitionId, ex);
            actionErrorMessage = L["Error.Start", ex.Message];
        }
        finally
        {
            isStarting = false;
            startingProcessDefinitionId = null;
        }
    }

    private void ViewInstances(ProcessDefinitionSummary version)
    {
        Navigation.NavigateTo($"/process-instances/{Uri.EscapeDataString(version.ProcessDefinitionKey)}/{version.Version}");
    }

    private async Task ToggleActive(ProcessDefinitionSummary definition)
    {
        try
        {
            isToggling = true;
            togglingProcessKey = definition.ProcessDefinitionKey;
            actionErrorMessage = null;
            actionSuccessMessage = null;

            if (definition.IsActive)
            {
                await CommandService.DisableProcess(definition.ProcessDefinitionKey);
                actionSuccessMessage = L["Message.Disabled", definition.ProcessDefinitionKey];
            }
            else
            {
                await CommandService.EnableProcess(definition.ProcessDefinitionKey);
                actionSuccessMessage = L["Message.Enabled", definition.ProcessDefinitionKey];
            }

            if (grid is not null)
            {
                await grid.RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            LogToggleProcessError(definition.ProcessDefinitionKey, ex);
            actionErrorMessage = L["Error.Toggle", ex.Message];
        }
        finally
        {
            isToggling = false;
            togglingProcessKey = null;
        }
    }

    private ProcessDefinitionSummary? promoteVersion;

    private void ShowPromote(ProcessDefinitionSummary version) => promoteVersion = version;

    public void Dispose()
    {
        pagination.TotalItemCountChanged -= OnTotalItemCountChanged;
        searchDebounceTimer?.Dispose();
    }
}
