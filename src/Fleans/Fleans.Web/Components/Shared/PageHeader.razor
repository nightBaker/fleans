@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<PageHeader> L

@* Orbit page header: mono eyebrow over the page title, page actions on the right. Compact: one row —
   breadcrumbs, then the title — for working surfaces where the height belongs to the content. *@
<div class="orbit-page-header @(Compact ? "orbit-page-header--compact" : null)">
    <div class="orbit-page-header__title">
        @if (ShowBackButton)
        {
            <FluentButton Appearance="Appearance.Stealth"
                          IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.ArrowLeft())"
                          Title="@L["Action.GoBack"]"
                          AriaLabel="@L["Action.GoBack"]"
                          @onclick="HandleGoBack" />
        }
        <div class="orbit-page-header__text">
            @if (Compact && Breadcrumbs is { Count: > 0 })
            {
                <nav class="orbit-crumbs" aria-label="@L["Navigation.Breadcrumb"]">
                    @foreach (var crumb in Breadcrumbs)
                    {
                        @if (crumb.Href is null)
                        {
                            <span>@crumb.Label</span>
                        }
                        else
                        {
                            <a href="@crumb.Href">@crumb.Label</a>
                        }
                        <span class="orbit-crumbs__sep" aria-hidden="true">/</span>
                    }
                </nav>
            }
            else
            {
                <span class="orbit-eyebrow">@Eyebrow</span>
            }
            <h1 tabindex="-1">@Title</h1>
        </div>
    </div>

    @if (Actions is not null)
    {
        <div class="orbit-page-header__actions">
            @Actions
        </div>
    }
</div>

@inject NavigationManager Navigation

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Mono line above the title; defaults to "Fleans".</summary>
    [Parameter]
    public string Eyebrow { get; set; } = "Fleans";

    [Parameter]
    public string? GoBackUrl { get; set; }

    [Parameter]
    public EventCallback OnGoBack { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>One-row header (~48px): breadcrumbs (or the eyebrow) inline before a smaller title.</summary>
    [Parameter]
    public bool Compact { get; set; }

    /// <summary>Compact only: the trail before the title; a crumb without <see cref="Crumb.Href"/> is plain text.</summary>
    [Parameter]
    public IReadOnlyList<Crumb>? Breadcrumbs { get; set; }

    public sealed record Crumb(string Label, string? Href = null);

    private bool ShowBackButton => GoBackUrl is not null || OnGoBack.HasDelegate;

    private async Task HandleGoBack()
    {
        if (OnGoBack.HasDelegate)
            await OnGoBack.InvokeAsync();
        else if (GoBackUrl is not null)
            Navigation.NavigateTo(GoBackUrl);
    }
}
