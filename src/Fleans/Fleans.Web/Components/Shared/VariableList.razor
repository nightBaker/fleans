@* Key/value list of workflow variables (instance journal entry details, variables panel, debugger). *@
@if (Variables.Count == 0)
{
    <span class="instance-entry__muted">No variables.</span>
}
else
{
    <dl class="instance-entry__vars" data-testid="instance-variable-list">
        @foreach (var (key, value) in Variables.OrderBy(v => v.Key, StringComparer.Ordinal))
        {
            var changed = Changed?.Contains(key) == true;
            <dt class="@(changed ? "is-changed" : null)">@key</dt>
            <dd class="@(changed ? "is-changed" : null)" title="@value">@value</dd>
        }
    </dl>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, string> Variables { get; set; } = default!;

    /// <summary>Names to mark as just changed (the debugger's current step).</summary>
    [Parameter] public IReadOnlySet<string>? Changed { get; set; }
}
