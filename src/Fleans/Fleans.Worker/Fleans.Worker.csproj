<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>15</LangVersion>
    <!-- Engine-internal: the stateless-worker grain implementations (script executor, condition
         evaluator) and the placement filter behind [WorkerPlacement]. References only
         Fleans.Application.Abstractions. Custom tasks don't run here: workers are gRPC clients
         built on Fleans.ExternalTasks.Sdk (#1013). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.4.0" />
    <PackageReference Include="Microsoft.Orleans.Runtime" Version="10.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fleans.Application.Abstractions\Fleans.Application.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fleans.Application.Tests" />
  </ItemGroup>

</Project>
