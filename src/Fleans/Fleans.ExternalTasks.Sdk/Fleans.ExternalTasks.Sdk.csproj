<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>15</LangVersion>
    <!-- NuGet packaging: the .NET client of the external-task worker gRPC protocol, which is how
         every custom task runs. A worker process built on it is a plain generic host that connects
         to a Fleans API over gRPC (or gRPC-Web). It has NO Orleans dependency, direct or transitive
         (#1013; CI guards it) — so no reference to the engine's Abstractions projects, which pull
         Microsoft.Orleans.Sdk. Protos/external_task_worker.proto is the only contract with the
         engine, and the generated client stays internal so workers depend only on this API. -->
    <IsPackable>true</IsPackable>
    <PackageId>Fleans.ExternalTasks.Sdk</PackageId>
    <Description>Write Fleans custom-task workers: an ExternalTaskHandler base class and a hosted gRPC worker that receives the tasks of a Fleans engine and reports their outcome. No Orleans dependency.</Description>
    <PackageTags>fleans;workflow;bpmn;external-task;custom-task;grpc;worker</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.33.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
    <PackageReference Include="Grpc.Net.Client.Web" Version="2.76.0" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\external_task_worker.proto" GrpcServices="Client" Access="Internal" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fleans.Application.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Shipped for worker authors generating a client in another language. -->
    <None Include="Protos\external_task_worker.proto" Pack="true" PackagePath="protos\" />
  </ItemGroup>

</Project>
