<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <!-- NuGet packaging: the HTTP contract between the BPMN editor's AI assistant panel
         (Fleans.Web) and an assistant backend (#1015). Plain records with no dependencies, so a
         .NET backend can reference it; backends in other languages follow the JSON shapes
         documented on the website. -->
    <IsPackable>true</IsPackable>
    <PackageId>Fleans.Assistant.Contracts</PackageId>
    <Description>The HTTP + server-sent-events contract a Fleans BPMN editor assistant backend implements: the chat request the editor sends and the text, proposal and error events it streams back.</Description>
    <PackageTags>fleans;workflow;bpmn;assistant;ai;sse</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
