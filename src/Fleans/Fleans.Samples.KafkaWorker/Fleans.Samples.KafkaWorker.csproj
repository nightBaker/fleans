<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sample external worker for Kafka external tasks (#979): reads `fleans.tasks.<type>` with its
       own consumer group and completes each task over REST. Deliberately engine-free — Confluent.Kafka
       and HttpClient only, the same shape a worker in any language has. Also the load-test worker
       (tests/load/overrides/kafka-worker.yml). Never packed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.6.1" />
  </ItemGroup>

</Project>
