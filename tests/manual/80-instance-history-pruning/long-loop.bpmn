<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <process id="long-loop" isExecutable="true">
    <startEvent id="start" />
    <scriptTask id="init" scriptFormat="csharp">
      <script>_context.i = 0</script>
    </scriptTask>
    <scriptTask id="step" scriptFormat="csharp">
      <script>_context.i = _context.i + 1</script>
    </scriptTask>
    <exclusiveGateway id="again" default="toHold" />
    <userTask id="hold" />
    <endEvent id="end" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="init" />
    <sequenceFlow id="f2" sourceRef="init" targetRef="step" />
    <sequenceFlow id="f3" sourceRef="step" targetRef="again" />
    <sequenceFlow id="loop" sourceRef="again" targetRef="step">
      <conditionExpression>${i &lt; 200}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="toHold" sourceRef="again" targetRef="hold" />
    <sequenceFlow id="f4" sourceRef="hold" targetRef="end" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="long-loop">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="100" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="init_di" bpmnElement="init">
        <dc:Bounds x="190" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="step_di" bpmnElement="step">
        <dc:Bounds x="340" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="again_di" bpmnElement="again" isMarkerVisible="true">
        <dc:Bounds x="490" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="hold_di" bpmnElement="hold">
        <dc:Bounds x="590" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="740" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="136" y="200" /><di:waypoint x="190" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="290" y="200" /><di:waypoint x="340" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="440" y="200" /><di:waypoint x="490" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="loop_di" bpmnElement="loop">
        <di:waypoint x="515" y="175" /><di:waypoint x="515" y="110" /><di:waypoint x="390" y="110" /><di:waypoint x="390" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toHold_di" bpmnElement="toHold">
        <di:waypoint x="540" y="200" /><di:waypoint x="590" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="690" y="200" /><di:waypoint x="740" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
