<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- Child process invoked once per item by parallel-call-activity.bpmn. -->
  <process id="mi-child-process" isExecutable="true">
    <startEvent id="childStart" />
    <scriptTask id="childScript" scriptFormat="csharp">
      <script>_context.result = "child-" + _context.item</script>
    </scriptTask>
    <endEvent id="childEnd" />
    <sequenceFlow id="cf1" sourceRef="childStart" targetRef="childScript" />
    <sequenceFlow id="cf2" sourceRef="childScript" targetRef="childEnd" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_mi-child-process">
    <bpmndi:BPMNPlane id="BPMNPlane_mi-child-process" bpmnElement="mi-child-process">
      <bpmndi:BPMNShape id="childStart_di" bpmnElement="childStart"><dc:Bounds x="180" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="childScript_di" bpmnElement="childScript"><dc:Bounds x="276" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="childEnd_di" bpmnElement="childEnd"><dc:Bounds x="436" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="cf1_di" bpmnElement="cf1"><di:waypoint x="216" y="118" /><di:waypoint x="246" y="118" /><di:waypoint x="246" y="140" /><di:waypoint x="276" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="cf2_di" bpmnElement="cf2"><di:waypoint x="376" y="140" /><di:waypoint x="406" y="140" /><di:waypoint x="406" y="118" /><di:waypoint x="436" y="118" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
