<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="defs_unhandled_failure" targetNamespace="http://fleans.io/bpmn">
  <bpmn:process id="unhandled-script-failure" isExecutable="true">
    <bpmn:startEvent id="start" />

    <!-- `new[] { ... }` is not supported by DynamicExpresso: this script fails at parse time. -->
    <bpmn:scriptTask id="boom" scriptFormat="csharp">
      <bpmn:script>_context.items = new[] { 1, 2, 3 }</bpmn:script>
    </bpmn:scriptTask>

    <bpmn:scriptTask id="after" scriptFormat="csharp">
      <bpmn:script>_context.reachedAfter = true</bpmn:script>
    </bpmn:scriptTask>

    <bpmn:endEvent id="end" />

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="boom" />
    <bpmn:sequenceFlow id="f2" sourceRef="boom"  targetRef="after" />
    <bpmn:sequenceFlow id="f3" sourceRef="after" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diag">
    <bpmndi:BPMNPlane id="plane" bpmnElement="unhandled-script-failure">
      <bpmndi:BPMNShape id="s_start" bpmnElement="start"><dc:Bounds x="100" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_boom"  bpmnElement="boom"><dc:Bounds x="200" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_after" bpmnElement="after"><dc:Bounds x="350" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_end"   bpmnElement="end"><dc:Bounds x="500" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="e_f1" bpmnElement="f1"><di:waypoint x="136" y="118" /><di:waypoint x="200" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f2" bpmnElement="f2"><di:waypoint x="300" y="118" /><di:waypoint x="350" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f3" bpmnElement="f3"><di:waypoint x="450" y="118" /><di:waypoint x="500" y="118" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
