<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <!-- Version 1 of versioned-order. Shares the user-task id 'approve' with v2 on purpose: if a running v1 instance were migrated onto the v2 graph, completing 'approve' would route to v2Finish instead of v1Finish. -->
  <process id="versioned-order" isExecutable="true">
    <startEvent id="start" />
    <scriptTask id="v1Prepare" scriptFormat="csharp">
      <script>_context.preparedBy = "v1"</script>
    </scriptTask>
    <userTask id="approve" name="Approve (v1)" />
    <scriptTask id="v1Finish" scriptFormat="csharp">
      <script>_context.finishedBy = "v1"</script>
    </scriptTask>
    <endEvent id="v1End" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="v1Prepare" />
    <sequenceFlow id="f2" sourceRef="v1Prepare" targetRef="approve" />
    <sequenceFlow id="f3" sourceRef="approve" targetRef="v1Finish" />
    <sequenceFlow id="f4" sourceRef="v1Finish" targetRef="v1End" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="versioned-order">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="180" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="v1Prepare_di" bpmnElement="v1Prepare">
        <dc:Bounds x="276" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approve_di" bpmnElement="approve">
        <dc:Bounds x="436" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="v1Finish_di" bpmnElement="v1Finish">
        <dc:Bounds x="596" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="v1End_di" bpmnElement="v1End">
        <dc:Bounds x="756" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="216" y="200" />
        <di:waypoint x="276" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="376" y="200" />
        <di:waypoint x="436" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="536" y="200" />
        <di:waypoint x="596" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="696" y="200" />
        <di:waypoint x="756" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
