<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <!-- Version 2 of the called child. No user task; completes straight through. -->
  <process id="versioned-child" isExecutable="true">
    <startEvent id="childStart" />
    <scriptTask id="childV2Work" scriptFormat="csharp">
      <script>_context.result = "child-v2"</script>
    </scriptTask>
    <endEvent id="childV2End" />
    <sequenceFlow id="f1" sourceRef="childStart" targetRef="childV2Work" />
    <sequenceFlow id="f2" sourceRef="childV2Work" targetRef="childV2End" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="versioned-child">
      <bpmndi:BPMNShape id="childStart_di" bpmnElement="childStart">
        <dc:Bounds x="180" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="childV2Work_di" bpmnElement="childV2Work">
        <dc:Bounds x="276" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="childV2End_di" bpmnElement="childV2End">
        <dc:Bounds x="436" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="216" y="200" />
        <di:waypoint x="276" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="376" y="200" />
        <di:waypoint x="436" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
