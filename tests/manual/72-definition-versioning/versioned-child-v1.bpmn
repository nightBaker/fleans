<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI">
  <!-- Version 1 of the called child. Blocks on childHold so an in-flight v1 child can be observed surviving a v2 deploy. -->
  <process id="versioned-child" isExecutable="true">
    <startEvent id="childStart" />
    <scriptTask id="childV1Work" scriptFormat="csharp">
      <script>_context.result = "child-v1"</script>
    </scriptTask>
    <userTask id="childHold" name="Hold child v1" />
    <endEvent id="childV1End" />
    <sequenceFlow id="f1" sourceRef="childStart" targetRef="childV1Work" />
    <sequenceFlow id="f2" sourceRef="childV1Work" targetRef="childHold" />
    <sequenceFlow id="f3" sourceRef="childHold" targetRef="childV1End" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="versioned-child">
      <bpmndi:BPMNShape id="childStart_di" bpmnElement="childStart">
        <dc:Bounds x="180" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="childV1Work_di" bpmnElement="childV1Work">
        <dc:Bounds x="276" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="childHold_di" bpmnElement="childHold">
        <dc:Bounds x="436" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="childV1End_di" bpmnElement="childV1End">
        <dc:Bounds x="596" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="216" y="200" />
        <di:waypoint x="276" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="376" y="200" />
        <di:waypoint x="436" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="536" y="200" />
        <di:waypoint x="596" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
