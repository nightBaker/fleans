<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="Definitions_1"
             targetNamespace="http://bpmn.io/schema/bpmn">
  <!--
    `amount` is supplied as a start variable (POST /Execution/start).
    Conditional watchers are evaluated in the execution loop whenever another activity
    completes, against the catch event's own variable scope. Parallel branches get a
    cloned copy of the variables at the fork, so `parallel-task` is only the evaluation
    trigger: completing it re-evaluates `amount > 500` against the value the
    `wait-for-amount` branch inherited from the start variables.
  -->
  <process id="conditional-event-test" isExecutable="true">
    <startEvent id="start">
      <outgoing>f1</outgoing>
    </startEvent>

    <parallelGateway id="fork">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
      <outgoing>f5</outgoing>
    </parallelGateway>

    <intermediateCatchEvent id="wait-for-amount">
      <incoming>f2</incoming>
      <outgoing>f3</outgoing>
      <conditionalEventDefinition>
        <condition>amount &gt; 500</condition>
      </conditionalEventDefinition>
    </intermediateCatchEvent>

    <scriptTask id="after-condition" scriptFormat="csharp">
      <incoming>f3</incoming>
      <outgoing>f4</outgoing>
      <script>_context.result = "condition-met"</script>
    </scriptTask>

    <endEvent id="end">
      <incoming>f4</incoming>
    </endEvent>

    <task id="parallel-task">
      <incoming>f5</incoming>
      <outgoing>f6</outgoing>
    </task>

    <endEvent id="end-parallel">
      <incoming>f6</incoming>
    </endEvent>

    <sequenceFlow id="f1" sourceRef="start" targetRef="fork" />
    <sequenceFlow id="f2" sourceRef="fork" targetRef="wait-for-amount" />
    <sequenceFlow id="f3" sourceRef="wait-for-amount" targetRef="after-condition" />
    <sequenceFlow id="f4" sourceRef="after-condition" targetRef="end" />
    <sequenceFlow id="f5" sourceRef="fork" targetRef="parallel-task" />
    <sequenceFlow id="f6" sourceRef="parallel-task" targetRef="end-parallel" />
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="conditional-event-test">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="180" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fork_di" bpmnElement="fork">
        <dc:Bounds x="265" y="193" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait-for-amount_di" bpmnElement="wait-for-amount">
        <dc:Bounds x="372" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="after-condition_di" bpmnElement="after-condition">
        <dc:Bounds x="470" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="630" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="parallel-task_di" bpmnElement="parallel-task">
        <dc:Bounds x="340" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end-parallel_di" bpmnElement="end-parallel">
        <dc:Bounds x="502" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="216" y="218" />
        <di:waypoint x="265" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="315" y="218" />
        <di:waypoint x="372" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="408" y="218" />
        <di:waypoint x="470" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="570" y="218" />
        <di:waypoint x="630" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="290" y="243" />
        <di:waypoint x="290" y="350" />
        <di:waypoint x="340" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="440" y="350" />
        <di:waypoint x="502" y="350" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
