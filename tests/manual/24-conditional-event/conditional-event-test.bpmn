<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="Definitions_1"
             targetNamespace="http://bpmn.io/schema/bpmn">
  <process id="conditional-event-test" isExecutable="true">
    <startEvent id="start">
      <outgoing>f1</outgoing>
    </startEvent>

    <scriptTask id="set-initial" scriptFormat="csharp">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
      <script>amount = 0;</script>
    </scriptTask>

    <parallelGateway id="fork">
      <incoming>f2</incoming>
      <outgoing>f3</outgoing>
      <outgoing>f6</outgoing>
    </parallelGateway>

    <intermediateCatchEvent id="wait-for-amount">
      <incoming>f3</incoming>
      <outgoing>f4</outgoing>
      <conditionalEventDefinition>
        <condition>amount &gt; 500</condition>
      </conditionalEventDefinition>
    </intermediateCatchEvent>

    <scriptTask id="after-condition" scriptFormat="csharp">
      <incoming>f4</incoming>
      <outgoing>f5</outgoing>
      <script>result = "condition-met";</script>
    </scriptTask>

    <endEvent id="end">
      <incoming>f5</incoming>
    </endEvent>

    <!-- External task on a parallel branch. Completing it via
         POST /Execution/complete-activity with {"amount": 600} merges the variable
         and the completion triggers re-evaluation of the conditional watcher. -->
    <task id="update-amount">
      <incoming>f6</incoming>
      <outgoing>f7</outgoing>
    </task>

    <endEvent id="end-update">
      <incoming>f7</incoming>
    </endEvent>

    <sequenceFlow id="f1" sourceRef="start" targetRef="set-initial" />
    <sequenceFlow id="f2" sourceRef="set-initial" targetRef="fork" />
    <sequenceFlow id="f3" sourceRef="fork" targetRef="wait-for-amount" />
    <sequenceFlow id="f4" sourceRef="wait-for-amount" targetRef="after-condition" />
    <sequenceFlow id="f5" sourceRef="after-condition" targetRef="end" />
    <sequenceFlow id="f6" sourceRef="fork" targetRef="update-amount" />
    <sequenceFlow id="f7" sourceRef="update-amount" targetRef="end-update" />
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="conditional-event-test">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="180" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="set-initial_di" bpmnElement="set-initial">
        <dc:Bounds x="270" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fork_di" bpmnElement="fork">
        <dc:Bounds x="425" y="193" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait-for-amount_di" bpmnElement="wait-for-amount">
        <dc:Bounds x="532" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="after-condition_di" bpmnElement="after-condition">
        <dc:Bounds x="630" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="790" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="update-amount_di" bpmnElement="update-amount">
        <dc:Bounds x="500" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end-update_di" bpmnElement="end-update">
        <dc:Bounds x="662" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="216" y="218" />
        <di:waypoint x="270" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="370" y="218" />
        <di:waypoint x="425" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="475" y="218" />
        <di:waypoint x="532" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="568" y="218" />
        <di:waypoint x="630" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="730" y="218" />
        <di:waypoint x="790" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="450" y="243" />
        <di:waypoint x="450" y="350" />
        <di:waypoint x="500" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7">
        <di:waypoint x="600" y="350" />
        <di:waypoint x="662" y="350" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
