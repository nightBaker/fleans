<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- Timer Start Event (timeDate). The E2E spec rewrites the timeDate to "now + a few
       seconds" before deploying; when running the manual plan, edit it to a moment ~30s
       in the future (ISO-8601, UTC). -->
  <process id="timer-start-date-test" isExecutable="true">
    <startEvent id="timerStart">
      <timerEventDefinition>
        <timeDate>2099-01-01T00:00:00Z</timeDate>
      </timerEventDefinition>
    </startEvent>
    <scriptTask id="afterTimerStart" scriptFormat="csharp">
      <script>_context.startedByTimer = true</script>
    </scriptTask>
    <endEvent id="end" />
    <sequenceFlow id="f1" sourceRef="timerStart" targetRef="afterTimerStart" />
    <sequenceFlow id="f2" sourceRef="afterTimerStart" targetRef="end" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_timer-start-date-test">
    <bpmndi:BPMNPlane id="BPMNPlane_timer-start-date-test" bpmnElement="timer-start-date-test">
      <bpmndi:BPMNShape id="timerStart_di" bpmnElement="timerStart"><dc:Bounds x="180" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="afterTimerStart_di" bpmnElement="afterTimerStart"><dc:Bounds x="276" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="436" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="216" y="118" /><di:waypoint x="246" y="118" /><di:waypoint x="246" y="140" /><di:waypoint x="276" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="376" y="140" /><di:waypoint x="406" y="140" /><di:waypoint x="406" y="118" /><di:waypoint x="436" y="118" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
