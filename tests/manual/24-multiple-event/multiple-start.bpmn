<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <message id="msg_multiStart" name="multiStartOrder" />
  <signal id="sig_multiStart" name="multiStartOverride" />
  <!-- Multiple Start Event: either the message or the signal creates a new instance. -->
  <process id="multiple-start-test" isExecutable="true">
    <startEvent id="multiStart">
      <messageEventDefinition messageRef="msg_multiStart" />
      <signalEventDefinition signalRef="sig_multiStart" />
    </startEvent>
    <scriptTask id="afterStart" scriptFormat="csharp">
      <script>_context.started = true</script>
    </scriptTask>
    <endEvent id="end" />
    <sequenceFlow id="f1" sourceRef="multiStart" targetRef="afterStart" />
    <sequenceFlow id="f2" sourceRef="afterStart" targetRef="end" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_multiple-start-test">
    <bpmndi:BPMNPlane id="BPMNPlane_multiple-start-test" bpmnElement="multiple-start-test">
      <bpmndi:BPMNShape id="multiStart_di" bpmnElement="multiStart"><dc:Bounds x="180" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="afterStart_di" bpmnElement="afterStart"><dc:Bounds x="276" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="436" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="216" y="118" /><di:waypoint x="246" y="118" /><di:waypoint x="246" y="140" /><di:waypoint x="276" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="376" y="140" /><di:waypoint x="406" y="140" /><di:waypoint x="406" y="118" /><di:waypoint x="436" y="118" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
