<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://fleans.io/manual/81">
  <!-- v2 of migration-order: 'review' is renamed 'approve' (map review -> approve), it gets a
       non-interrupting reminder timer, and the path after it sets finishedBy = "v2". -->
  <process id="migration-order" isExecutable="true">
    <startEvent id="start" />
    <userTask id="approve" name="Approve (v2)" />
    <boundaryEvent id="remind" attachedToRef="approve" cancelActivity="false">
      <timerEventDefinition><timeDuration xsi:type="tFormalExpression">PT10S</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <endEvent id="remindEnd" />
    <scriptTask id="v2Finish" scriptFormat="csharp">
      <script>_context.finishedBy = "v2"</script>
    </scriptTask>
    <endEvent id="v2End" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="approve" />
    <sequenceFlow id="f2" sourceRef="approve" targetRef="v2Finish" />
    <sequenceFlow id="f3" sourceRef="v2Finish" targetRef="v2End" />
    <sequenceFlow id="f4" sourceRef="remind" targetRef="remindEnd" />
  </process>
  <bpmndi:BPMNDiagram id="d1"><bpmndi:BPMNPlane id="p1" bpmnElement="migration-order">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="180" y="182" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approve_di" bpmnElement="approve"><dc:Bounds x="276" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="remind_di" bpmnElement="remind"><dc:Bounds x="308" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="remindEnd_di" bpmnElement="remindEnd"><dc:Bounds x="308" y="320" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="v2Finish_di" bpmnElement="v2Finish"><dc:Bounds x="436" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="v2End_di" bpmnElement="v2End"><dc:Bounds x="596" y="182" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="216" y="200" /><di:waypoint x="276" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="376" y="200" /><di:waypoint x="436" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="536" y="200" /><di:waypoint x="596" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="326" y="258" /><di:waypoint x="326" y="320" /></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</definitions>
