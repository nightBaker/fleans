<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- Error boundary attached directly to a plain script task (no call activity).
       The script divides by the start variable `divisor`: divisor = 0 fails the task
       (error boundary path), any other value completes it (happy path). -->
  <process id="error-boundary-script-task" isExecutable="true">
    <startEvent id="start" />
    <scriptTask id="riskyScript" scriptFormat="csharp">
      <script>_context.quotient = 10 / _context.divisor</script>
    </scriptTask>
    <boundaryEvent id="errorBoundary" attachedToRef="riskyScript">
      <errorEventDefinition />
    </boundaryEvent>
    <scriptTask id="happyPath" scriptFormat="csharp">
      <script>_context.happyPath = true</script>
    </scriptTask>
    <scriptTask id="errorHandler" scriptFormat="csharp">
      <script>_context.errorHandled = true</script>
    </scriptTask>
    <endEvent id="happyEnd" />
    <endEvent id="errorEnd" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="riskyScript" />
    <sequenceFlow id="f2" sourceRef="riskyScript" targetRef="happyPath" />
    <sequenceFlow id="f3" sourceRef="happyPath" targetRef="happyEnd" />
    <sequenceFlow id="f4" sourceRef="errorBoundary" targetRef="errorHandler" />
    <sequenceFlow id="f5" sourceRef="errorHandler" targetRef="errorEnd" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_error-boundary-script-task">
    <bpmndi:BPMNPlane id="BPMNPlane_error-boundary-script-task" bpmnElement="error-boundary-script-task">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="180" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="riskyScript_di" bpmnElement="riskyScript"><dc:Bounds x="276" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="happyPath_di" bpmnElement="happyPath"><dc:Bounds x="436" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="errorHandler_di" bpmnElement="errorHandler"><dc:Bounds x="436" y="270" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="happyEnd_di" bpmnElement="happyEnd"><dc:Bounds x="596" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="errorEnd_di" bpmnElement="errorEnd"><dc:Bounds x="596" y="226" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="errorBoundary_di" bpmnElement="errorBoundary"><dc:Bounds x="286" y="162" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="216" y="118" /><di:waypoint x="246" y="118" /><di:waypoint x="246" y="140" /><di:waypoint x="276" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="376" y="140" /><di:waypoint x="436" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="536" y="140" /><di:waypoint x="566" y="140" /><di:waypoint x="566" y="118" /><di:waypoint x="596" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="304" y="198" /><di:waypoint x="304" y="310" /><di:waypoint x="436" y="310" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="536" y="310" /><di:waypoint x="566" y="310" /><di:waypoint x="566" y="244" /><di:waypoint x="596" y="244" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
