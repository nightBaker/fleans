{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Как работает runtime Fleans",
    "quality_profile": "showcase",
    "legend": {
      "entries": {
        "backend": {
          "label": "Логика runtime"
        },
        "messagebus": {
          "label": "Асинхронная работа"
        },
        "database": {
          "label": "Хранение состояния"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "core",
      "label": "WorkflowInstance — координатор одного процесса"
    },
    {
      "id": "async",
      "label": "Работа вне цикла и возврат результата"
    }
  ],
  "mainPath": [
    "entry",
    "pending",
    "execute",
    "aggregate",
    "advance",
    "persist"
  ],
  "nodes": [
    {
      "id": "entry",
      "lane": "async",
      "col": 0,
      "type": "backend",
      "label": "Начать / продолжить",
      "sublabel": "Старт или внешний результат",
      "width": 170,
      "yOffset": 40
    },
    {
      "id": "pending",
      "lane": "core",
      "col": 0,
      "type": "backend",
      "label": "Найти готовые шаги",
      "sublabel": "GetPendingActivities",
      "width": 170
    },
    {
      "id": "execute",
      "lane": "core",
      "col": 1,
      "type": "backend",
      "label": "Выполнить BPMN-шаг",
      "sublabel": "ExecuteAsync + адаптер",
      "width": 170
    },
    {
      "id": "aggregate",
      "lane": "core",
      "col": 2,
      "type": "backend",
      "label": "Изменить состояние",
      "sublabel": "Команды → события и эффекты",
      "width": 170
    },
    {
      "id": "advance",
      "lane": "core",
      "col": 3,
      "type": "backend",
      "label": "Выбрать следующие шаги",
      "sublabel": "Переходы, шлюзы, подпроцессы",
      "width": 170
    },
    {
      "id": "persist",
      "lane": "async",
      "col": 3,
      "type": "database",
      "label": "Сохранить и выйти",
      "sublabel": "Журнал + CQRS-проекция",
      "width": 170,
      "yOffset": 40
    },
    {
      "id": "worker",
      "lane": "async",
      "col": 2,
      "type": "messagebus",
      "label": "Внешняя работа",
      "sublabel": "Streams → обработчик → Worker",
      "width": 170,
      "yOffset": 40
    }
  ],
  "edges": [
    {
      "id": "enter",
      "from": "entry",
      "to": "pending",
      "label": "Вызов grain",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "pick",
      "from": "pending",
      "to": "execute",
      "label": "Для каждого шага",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "commands",
      "from": "execute",
      "to": "aggregate",
      "label": "Команды шага",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "transitions",
      "from": "aggregate",
      "to": "advance",
      "label": "Завершённые шаги",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "again",
      "from": "advance",
      "to": "pending",
      "label": "Есть готовые шаги",
      "role": "return",
      "variant": "default"
    },
    {
      "id": "flush",
      "from": "advance",
      "to": "persist",
      "label": "Готовых шагов нет",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "dispatch",
      "from": "aggregate",
      "to": "worker",
      "label": "Асинхронная задача",
      "role": "async",
      "variant": "dashed"
    },
    {
      "id": "result",
      "from": "worker",
      "to": "entry",
      "label": "CompleteActivity / FailActivity",
      "role": "return",
      "variant": "default"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Кто принимает решения",
      "items": [
        "WorkflowExecution хранит доменную логику. WorkflowInstance исполняет эффекты и управляет циклом."
      ]
    },
    {
      "dot": "amber",
      "title": "Как процесс просыпается",
      "items": [
        "Нет готовых шагов: вызов заканчивается. Процесс либо завершён, либо ждёт результат Worker, таймер, сообщение или user task."
      ]
    },
    {
      "dot": "emerald",
      "title": "Что сохраняется",
      "items": [
        "События и CQRS-проекция; при активации читаются snapshot и последующие события. Публикация задач идёт до финальной записи."
      ]
    }
  ]
}
