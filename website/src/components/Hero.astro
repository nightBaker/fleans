---
// Splash hero (overrides Starlight's Hero). Typographic, Saddle-style: eyebrow,
// oversized light title, large lead, pill actions, "made for … by …" footer row,
// with the overview video in a card to the right. On wide screens the hero is a
// scroll stage: the card grows from its slot to fill the viewport as you scroll.
// Driven by the `hero` frontmatter of src/content/docs/index.mdx.
const PAGE_TITLE_ID = '_top'; // Starlight's page-title anchor (not exported)

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};

// Hero card video (public/hero/), one cut per theme: fleans-hero-{dark,light}. Each has
// AV1 (~0.9 MB) plus an H.264 fallback (~1.4 MB) for browsers without AV1 decode; all
// silent, 1920×1200 (native, visually lossless: VMAF ≈ 97), faststart. The poster is the video's own (blank) first frame so
// playback starts without a flash. The script below picks the cut for the current theme.
const hero = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/hero/fleans-hero`;
---

<header class="fl-hero not-content" id="fl-hero">
  <div class="fl-hero-sticky">
    <div class="fl-hero-text">
      <div class="fl-hero-eyebrow">
        <span class="fl-chip">BPMN 2.0</span>
        <span class="fl-chip fl-chip--outline">.NET · Orleans</span>
      </div>

      <div class="fl-hero-body">
        <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
        {tagline && <p class="fl-hero-lead" set:html={tagline} />}
        {
          actions.length > 0 && (
            <div class="fl-hero-actions">
              {actions.map(({ link, text, variant, attrs }) => (
                <a
                  href={link}
                  class:list={['fl-button', variant !== 'primary' && 'fl-button--secondary']}
                  {...attrs}
                >
                  {text}
                </a>
              ))}
            </div>
          )
        }
      </div>

      <div class="fl-hero-foot">
        <p><span>made for</span> <a href="https://learn.microsoft.com/dotnet/orleans/">.NET Orleans</a></p>
        <p><span>by</span> <a href="https://github.com/nightBaker/fleans/graphs/contributors">Fleans contributors</a></p>
      </div>
    </div>

    <div class="fl-hero-slot">
      <figure class="fl-hero-card">
        <video
          id="fl-hero-video"
          width="1920"
          height="1200"
          data-base={hero}
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          disablepictureinpicture
          aria-label="Fleans overview: one command to start, any backend over REST, runs on your infrastructure, works with your storage, add silos to scale out"
        >
        </video>
        <script is:inline>
          // Runs right after the <video> is parsed, before any fetch starts, so only the
          // current theme's cut is ever downloaded. Re-runs on theme switch (see below).
          (() => {
            const v = document.getElementById('fl-hero-video');
            const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
            const apply = () => {
              const theme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
              if (v.dataset.theme === theme) return;
              const first = !v.dataset.theme;
              const t = v.currentTime;
              v.dataset.theme = theme;
              const b = `${v.dataset.base}-${theme}`;
              v.poster = reduce ? `${b}-still.jpg` : `${b}-poster.jpg`;
              v.replaceChildren(
                Object.assign(document.createElement('source'), { src: `${b}.av1.mp4`, type: 'video/mp4; codecs="av01.0.08M.08"' }),
                Object.assign(document.createElement('source'), { src: `${b}.mp4`, type: 'video/mp4' }),
              );
              if (first) return;
              // Theme switched mid-loop: carry on from the same moment in the other cut.
              v.load();
              v.addEventListener('loadedmetadata', () => { v.currentTime = t; if (!reduce) v.play().catch(() => {}); }, { once: true });
            };
            apply();
            new MutationObserver(apply).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
          })();
        </script>
      </figure>
    </div>
  </div>
</header>
<script is:inline>
  (() => {
    const heroEl = document.getElementById('fl-hero');
    const v = document.getElementById('fl-hero-video');
    if (!heroEl || !v) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');

    // Playback. Reduced motion: no autoplay, show the finished frame and let the user press play.
    if (reduce.matches) {
      v.removeAttribute('autoplay');
      v.pause();
      v.controls = true;
    } else {
      // Some browsers drop autoplay when the attribute is parsed before `muted` sticks.
      v.muted = true;
      const play = () => v.play().catch(() => {});
      play();
      // Don't burn CPU decoding a loop nobody is looking at.
      new IntersectionObserver(([e]) => (e.isIntersecting ? play() : v.pause())).observe(v);
    }

    // Scroll stage: the card grows from its slot (right of the text) to the full viewport.
    const sticky = heroEl.querySelector('.fl-hero-sticky');
    const slot = heroEl.querySelector('.fl-hero-slot');
    const card = heroEl.querySelector('.fl-hero-card');
    const panel = heroEl.closest('.content-panel');
    const wide = matchMedia('(min-width: 64rem)');
    const lerp = (a, b, t) => a + (b - a) * t;
    const ease = (t) => 1 - Math.pow(1 - t, 3);
    let frame = 0;

    const update = () => {
      frame = 0;
      const on = wide.matches && !reduce.matches;
      heroEl.classList.toggle('is-stage', on);
      if (!on) {
        card.removeAttribute('style');
        heroEl.style.removeProperty('--fl-hero-p');
        heroEl.style.removeProperty('margin-top');
        return;
      }
      // Pull the stage up over Starlight's content-panel top padding so the pinned box
      // starts right under the header and the whole hero fits the first viewport.
      if (panel) heroEl.style.marginTop = `-${getComputedStyle(panel).paddingTop}`;
      const s = sticky.getBoundingClientRect();
      const h = heroEl.getBoundingClientRect();
      const r = slot.getBoundingClientRect();
      const range = Math.max(1, h.height - s.height);
      const t = ease(Math.min(1, Math.max(0, (s.top - h.top) / range)));
      // Full bleed: from the viewport's left edge to the scrollbar, top of the sticky box down.
      const vw = document.documentElement.clientWidth;
      card.style.left = `${lerp(r.left - s.left, -s.left, t)}px`;
      card.style.top = `${lerp(r.top - s.top, 0, t)}px`;
      card.style.width = `${lerp(r.width, vw, t)}px`;
      card.style.height = `${lerp(r.height, s.height, t)}px`;
      heroEl.style.setProperty('--fl-hero-p', t.toFixed(4));
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
    wide.addEventListener('change', schedule);
    reduce.addEventListener('change', schedule);
    update();
  })();
</script>

<style>
  .fl-hero {
    padding-block: 3rem 2.5rem;
  }
  .fl-hero-sticky {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .fl-hero-text {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 4rem;
  }
  .fl-hero-eyebrow {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .fl-hero-body h1 {
    margin: 0 0 2.5rem;
    font-size: clamp(3.5rem, 9vw, 7.5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--fl-text);
  }
  .fl-hero-lead {
    max-width: 64rem;
    margin: 0;
    font-size: clamp(1.375rem, 2.6vw, 2rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--fl-text);
  }
  .fl-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 3rem;
  }
  .fl-hero-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
  }
  .fl-hero-foot p {
    margin: 0;
    color: var(--fl-text);
  }
  .fl-hero-foot span {
    color: var(--fl-text-muted);
  }
  .fl-hero-foot a {
    color: var(--fl-text);
    text-decoration: none;
    font-weight: 500;
  }
  .fl-hero-foot a:hover {
    color: var(--fl-accent);
  }

  .fl-hero-slot {
    aspect-ratio: 16 / 10;
  }
  .fl-hero-card {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: var(--fl-radius);
    /* Each cut's own background colour, so letterboxing never shows a seam. */
    background: #16181c;
  }
  :global(:root[data-theme='light']) .fl-hero-card {
    background: #ffffff;
  }
  .fl-hero-card video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Wide screens: text left, card right. */
  @media (min-width: 64rem) {
    .fl-hero-sticky {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      align-items: center;
      gap: 3rem;
      min-height: calc(100svh - var(--sl-nav-height) - 5.5rem);
    }
    .fl-hero-text {
      align-self: stretch;
    }
    .fl-hero-body h1 {
      font-size: clamp(3.5rem, 7vw, 7rem);
    }
    .fl-hero-lead {
      font-size: clamp(1.25rem, 1.6vw, 1.625rem);
    }
    .fl-hero-foot {
      font-size: clamp(1.125rem, 1.4vw, 1.375rem);
    }
  }

  /* Scroll stage (set by the script on wide screens without reduced motion): the hero is
     ~2 viewports tall, its content is pinned, and the card is positioned by the script. */
  .fl-hero:global(.is-stage) {
    height: calc(200svh - var(--sl-nav-height));
    padding-block: 0;
  }
  .fl-hero:global(.is-stage) .fl-hero-sticky {
    position: sticky;
    top: var(--sl-nav-height);
    height: calc(100svh - var(--sl-nav-height));
    min-height: 0;
    padding-block: 3rem 2.5rem;
    box-sizing: border-box;
  }
  .fl-hero:global(.is-stage) .fl-hero-text {
    opacity: calc(1 - var(--fl-hero-p, 0) * 2);
  }
  .fl-hero:global(.is-stage) .fl-hero-card {
    position: absolute;
    z-index: 1;
    border-radius: calc(var(--fl-radius) * (1 - var(--fl-hero-p, 0)));
  }

  @media (prefers-reduced-motion: no-preference) {
    .fl-hero-body > * {
      animation: fl-rise 600ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
    .fl-hero-body > :nth-child(2) {
      animation-delay: 90ms;
    }
    .fl-hero-body > :nth-child(3) {
      animation-delay: 180ms;
    }
  }
  @keyframes fl-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>
